* {
    bg0: #090c12ee;
    bg1: #101722ee;
    fg0: #d7f5ff;
    cyan: #17d4ff;
    pink: #ff5ea8;
    border: #1ad8ff77;
}

window {
    location: center;
    width: 38%;
    border: 2px;
    border-color: @border;
    border-radius: 12px;
    background-color: @bg0;
}

mainbox {
    spacing: 10px;
    padding: 14px;
}

inputbar {
    background-color: @bg1;
    border-radius: 8px;
    padding: 8px;
}

prompt {
    text-color: @cyan;
    padding: 0 8px 0 4px;
}

entry {
    text-color: @fg0;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: false;
    scrollbar: true;
    background-color: transparent;
}

element {
    padding: 8px;
    border-radius: 8px;
    text-color: @fg0;
}

element selected {
    background-color: #0a2530;
    text-color: @cyan;
}

element-icon {
    size: 1.1em;
}

mode-switcher {
    spacing: 8px;
}

button selected {
    background-color: @pink;
    text-color: #0a0f14;
}
