* {
    bg:       {{colors.surface_container_lowest.default.hex}}e8;
    bg-alt:   {{colors.surface_container.default.hex}}ee;
    bg-high:  {{colors.surface_container_high.default.hex}};
    fg:       {{colors.on_surface.default.hex}};
    fg-muted: {{colors.on_surface_variant.default.hex}};
    accent:   {{colors.primary.default.hex}};
    accent2:  {{colors.tertiary.default.hex}};
    border:   {{colors.primary.default.hex}}66;
    selected: {{colors.primary_container.default.hex}};
    sel-fg:   {{colors.on_primary_container.default.hex}};
}

window {
    location:         center;
    width:            38%;
    border:           2px;
    border-color:     @border;
    border-radius:    14px;
    background-color: @bg;
}

mainbox {
    spacing:  10px;
    padding:  14px;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          8px;
}

prompt {
    text-color: @accent;
    padding:    0 8px 0 4px;
}

entry {
    text-color: @fg;
}

placeholder {
    text-color: @fg-muted;
}

listview {
    lines:            10;
    columns:          1;
    fixed-height:     false;
    scrollbar:        true;
    background-color: transparent;
}

scrollbar {
    handle-color:     @accent;
    background-color: @bg-alt;
    border-radius:    4px;
    handle-width:     4px;
}

element {
    padding:      8px;
    border-radius:8px;
    text-color:   @fg;
    background-color: transparent;
}

element selected {
    background-color: @selected;
    text-color:       @sel-fg;
}

element-icon {
    size: 1.1em;
}

element-text {
    text-color: inherit;
}

mode-switcher {
    spacing: 8px;
}

button {
    text-color: @fg-muted;
    padding:    6px 10px;
    border-radius: 8px;
}

button selected {
    background-color: @accent;
    text-color:       {{colors.on_primary.default.hex}};
}

message {
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          8px;
}

textbox {
    text-color: @fg-muted;
}
