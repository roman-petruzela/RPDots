{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "RPRice",
  "author": "RPRice / matugen",
  "themes": [
    {
      "name": "RPRice Dark",
      "appearance": "dark",
      "style": {
        "accents": [
          "{{colors.primary.default.hex}}",
          "{{colors.tertiary.default.hex}}",
          "{{colors.secondary.default.hex}}"
        ],

        "background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 21 | set_saturation: 29 | set_alpha: 0.78 }}",
        "background.appearance": "transparent",
        "surface.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 30 | set_saturation: 27 | set_alpha: 0.82 }}",
        "elevated_surface.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 30 | set_saturation: 27 | set_alpha: 0.97 }}",
        "panel.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 28 | set_saturation: 29 | set_alpha: 0.78 }}",
        "pane_group.border": "{{colors.outline_variant.default.hex}}",
        "pane.focused_border": "{{colors.primary.default.hex}}",
        "panel.focused_border": "{{colors.tertiary.default.hex}}",
        "tab_bar.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 28 | set_saturation: 29 | set_alpha: 0.78 }}",
        "tab.inactive_background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 28 | set_saturation: 29 | set_alpha: 0.55 }}",
        "tab.active_background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 18 | set_saturation: 30 | set_alpha: 0.85 }}",
        "title_bar.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 28 | set_saturation: 29 | set_alpha: 0.78 }}",
        "title_bar.inactive_background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 28 | set_saturation: 29 | set_alpha: 0.55 }}",
        "toolbar.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 28 | set_saturation: 29 | set_alpha: 0.78 }}",
        "status_bar.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 28 | set_saturation: 29 | set_alpha: 0.78 }}",

        "border": "{{colors.outline_variant.default.hex}}",
        "border.variant": "{{colors.outline_variant.default.hex}}66",
        "border.focused": "{{colors.primary.default.hex}}",
        "border.selected": "{{colors.tertiary.default.hex}}",
        "border.transparent": "#00000000",
        "border.disabled": "{{colors.surface_container_high.default.hex}}",

        "element.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 30 | set_saturation: 27 | set_alpha: 0.82 }}",
        "element.hover": "{{colors.surface_container_high.default.hex}}",
        "element.active": "{{colors.primary_container.default.hex}}66",
        "element.selected": "{{colors.primary_container.default.hex}}88",
        "element.disabled": "{{colors.surface_container.default.hex}}66",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{colors.surface_container.default.hex}}88",
        "ghost_element.active": "{{colors.primary_container.default.hex}}55",
        "ghost_element.selected": "{{colors.primary_container.default.hex}}77",
        "ghost_element.disabled": "{{colors.surface_container.default.hex}}44",

        "drop_target.background": "{{colors.tertiary_container.default.hex}}55",
        "scrollbar.thumb.background": "{{colors.surface_container_highest.default.hex}}",
        "scrollbar.thumb.hover_background": "{{colors.primary.default.hex}}88",
        "scrollbar.thumb.border": "{{colors.outline_variant.default.hex}}",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "{{colors.outline_variant.default.hex}}33",

        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.placeholder": "{{colors.outline.default.hex}}",
        "text.accent": "{{colors.primary.default.hex}}",
        "text.disabled": "{{colors.outline.default.hex}}88",
        "icon": "{{colors.on_surface_variant.default.hex}}",
        "icon.muted": "{{colors.outline.default.hex}}",
        "icon.disabled": "{{colors.outline.default.hex}}88",
        "icon.placeholder": "{{colors.outline.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "link_text.hover": "{{colors.tertiary.default.hex}}",

        "editor.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 18 | set_saturation: 30 | set_alpha: 0.85 }}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.gutter.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 18 | set_saturation: 30 | set_alpha: 0.85 }}",
        "editor.subheader.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 30 | set_saturation: 27 | set_alpha: 0.82 }}",
        "editor.active_line.background": "{{colors.primary.default.hex}}14",
        "editor.highlighted_line.background": "{{colors.primary_container.default.hex}}22",
        "editor.line_number": "{{colors.outline.default.hex}}",
        "editor.active_line_number": "{{colors.primary.default.hex}}",
        "editor.invisible": "{{colors.outline.default.hex}}44",
        "editor.wrap_guide": "{{colors.outline_variant.default.hex}}33",
        "editor.active_wrap_guide": "{{colors.outline.default.hex}}55",
        "editor.document_highlight.read_background": "{{colors.primary_container.default.hex}}33",
        "editor.document_highlight.write_background": "{{colors.tertiary_container.default.hex}}33",

        "search.match_background": "{{colors.tertiary_container.default.hex}}55",

        "terminal.background": "{{ colors.primary_container.dark.hex_alpha | to_color | set_lightness: 18 | set_saturation: 30 | set_alpha: 0.85 }}",
        "terminal.foreground": "{{colors.primary.default.hex}}",
        "terminal.bright_foreground": "{{colors.on_primary_container.default.hex}}",
        "terminal.dim_foreground": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi.black": "{{colors.surface_container_lowest.default.hex}}",
        "terminal.ansi.red": "{{colors.error.default.hex}}",
        "terminal.ansi.green": "{{colors.tertiary.default.hex}}",
        "terminal.ansi.yellow": "{{colors.secondary.default.hex}}",
        "terminal.ansi.blue": "{{colors.primary.default.hex}}",
        "terminal.ansi.magenta": "{{colors.tertiary_fixed_dim.default.hex}}",
        "terminal.ansi.cyan": "{{colors.secondary_fixed_dim.default.hex}}",
        "terminal.ansi.white": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi.bright_black": "{{colors.surface_container_high.default.hex}}",
        "terminal.ansi.bright_red": "{{colors.on_error_container.default.hex}}",
        "terminal.ansi.bright_green": "{{colors.on_tertiary_container.default.hex}}",
        "terminal.ansi.bright_yellow": "{{colors.on_secondary_container.default.hex}}",
        "terminal.ansi.bright_blue": "{{colors.on_primary_container.default.hex}}",
        "terminal.ansi.bright_magenta": "{{colors.tertiary_fixed.default.hex}}",
        "terminal.ansi.bright_cyan": "{{colors.secondary_fixed.default.hex}}",
        "terminal.ansi.bright_white": "{{colors.on_surface.default.hex}}",

        "error": "{{colors.error.default.hex}}",
        "error.background": "{{colors.error_container.default.hex}}44",
        "error.border": "{{colors.error.default.hex}}88",
        "warning": "{{colors.secondary.default.hex}}",
        "warning.background": "{{colors.secondary_container.default.hex}}44",
        "warning.border": "{{colors.secondary.default.hex}}88",
        "info": "{{colors.tertiary.default.hex}}",
        "info.background": "{{colors.tertiary_container.default.hex}}44",
        "info.border": "{{colors.tertiary.default.hex}}88",
        "hint": "{{colors.secondary_fixed_dim.default.hex}}",
        "hint.background": "{{colors.secondary_container.default.hex}}33",
        "hint.border": "{{colors.secondary_fixed_dim.default.hex}}66",
        "success": "{{colors.tertiary.default.hex}}",
        "success.background": "{{colors.tertiary_container.default.hex}}44",
        "success.border": "{{colors.tertiary.default.hex}}88",
        "created": "{{colors.tertiary.default.hex}}",
        "created.background": "{{colors.tertiary_container.default.hex}}33",
        "created.border": "{{colors.tertiary.default.hex}}66",
        "modified": "{{colors.primary.default.hex}}",
        "modified.background": "{{colors.primary_container.default.hex}}33",
        "modified.border": "{{colors.primary.default.hex}}66",
        "renamed": "{{colors.secondary.default.hex}}",
        "renamed.background": "{{colors.secondary_container.default.hex}}33",
        "renamed.border": "{{colors.secondary.default.hex}}66",
        "deleted": "{{colors.error.default.hex}}",
        "deleted.background": "{{colors.error_container.default.hex}}33",
        "deleted.border": "{{colors.error.default.hex}}66",
        "conflict": "{{colors.tertiary_fixed_dim.default.hex}}",
        "conflict.background": "{{colors.tertiary_container.default.hex}}33",
        "conflict.border": "{{colors.tertiary_fixed_dim.default.hex}}66",
        "predictive": "{{colors.secondary.default.hex}}",
        "predictive.background": "{{colors.secondary_container.default.hex}}33",
        "predictive.border": "{{colors.secondary.default.hex}}55",
        "ignored": "{{colors.outline.default.hex}}",
        "ignored.background": "{{colors.surface_container.default.hex}}33",
        "ignored.border": "{{colors.outline.default.hex}}44",
        "hidden": "{{colors.outline.default.hex}}",
        "hidden.background": "{{colors.surface_container.default.hex}}22",
        "hidden.border": "{{colors.outline.default.hex}}33",
        "unreachable": "{{colors.outline.default.hex}}",
        "unreachable.background": "{{colors.surface_container.default.hex}}22",
        "unreachable.border": "{{colors.outline.default.hex}}33",

        "syntax": {
          "attribute":          { "color": "{{colors.secondary_fixed_dim.default.hex}}" },
          "boolean":            { "color": "{{colors.error.default.hex}}" },
          "comment":            { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "comment.doc":        { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": "italic" },
          "constant":           { "color": "{{colors.on_error_container.default.hex}}" },
          "constructor":        { "color": "{{colors.tertiary.default.hex}}" },
          "embedded":           { "color": "{{colors.on_surface.default.hex}}" },
          "emphasis":           { "color": "{{colors.tertiary.default.hex}}", "font_style": "italic" },
          "emphasis.strong":    { "color": "{{colors.tertiary.default.hex}}", "font_weight": 700 },
          "function":           { "color": "{{colors.primary_fixed.default.hex}}" },
          "function.builtin":   { "color": "{{colors.secondary_fixed_dim.default.hex}}" },
          "keyword":            { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
          "label":              { "color": "{{colors.secondary.default.hex}}" },
          "link_text":          { "color": "{{colors.tertiary.default.hex}}", "font_style": "italic" },
          "link_uri":           { "color": "{{colors.secondary_fixed_dim.default.hex}}" },
          "number":             { "color": "{{colors.on_error_container.default.hex}}" },
          "operator":           { "color": "{{colors.secondary_fixed_dim.default.hex}}" },
          "predictive":         { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "preproc":            { "color": "{{colors.tertiary.default.hex}}" },
          "property":           { "color": "{{colors.on_surface.default.hex}}" },
          "punctuation":        { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.bracket":{ "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation.delimiter": { "color": "{{colors.outline.default.hex}}" },
          "punctuation.list_marker": { "color": "{{colors.primary.default.hex}}" },
          "punctuation.special":{ "color": "{{colors.on_surface_variant.default.hex}}" },
          "string":             { "color": "{{colors.on_tertiary_container.default.hex}}" },
          "string.escape":      { "color": "{{colors.on_secondary_container.default.hex}}" },
          "string.regex":       { "color": "{{colors.on_tertiary_container.default.hex}}" },
          "string.special":     { "color": "{{colors.secondary_fixed_dim.default.hex}}" },
          "tag":                { "color": "{{colors.secondary.default.hex}}" },
          "text.literal":       { "color": "{{colors.on_tertiary_container.default.hex}}" },
          "title":              { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
          "type":               { "color": "{{colors.tertiary.default.hex}}" },
          "type.builtin":       { "color": "{{colors.error.default.hex}}" },
          "variable":           { "color": "{{colors.on_surface.default.hex}}" },
          "variable.special":   { "color": "{{colors.on_surface.default.hex}}", "font_style": "italic" },
          "variant":            { "color": "{{colors.secondary_fixed_dim.default.hex}}" }
        }
      }
    }
  ]
}
