input {
    keyboard {
        xkb {
            layout "cz,us"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    // tap, natural-scroll, accel-speed a focus-follows-mouse jsou v settings.kdl
    // (okno Settings / rp-settings). Flag zapnutý tady by include nevypnul —
    // niri nezná `natural-scroll false`.
    touchpad {
    }
    mouse {
    }
    trackpoint {
    }
}
output "Acer Technologies XZ240Q TQVEE0018511" {
    mode "1920x1080@165.003"
    scale 1
    transform "normal"
}
output "eDP-1" {
    mode "1920x1080@120.213"
    scale 1
    transform "normal"
}
layout {
    gaps 16
    center-focused-column "never"
    background-color "rgba(0, 0, 0, 0.0)"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 4
        active-color "#a78bfa"
        inactive-color "#4f4568"
        active-gradient from="#7aa2ff" to="#9d7cff" angle=45
    }
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    struts {
    }
}
// Blur (niri 26.04+, ext-background-effect). Default is xray: a window blurs the
// backdrop (layers with place-within-backdrop — awww and mpvpaper), not what is
// really behind it. A static wallpaper is blurred once and reused, so it is nearly
// free; a playing video wallpaper forces a re-blur every video frame. `xray false`
// blurs the actual content underneath (used by the wallpaper picker overlay).
// Windows opt in either themselves via the protocol (kitty `background_blur`,
// quickshell `BackgroundEffect`) or via `background-effect` rules below.
blur {
    passes 2
    offset 3.0
    noise 0.02
    saturation 1.5
}
include optional=true "~/.config/niri/theme-colors.kdl"
spawn-sh-at-startup "~/.local/bin/start-rice-services.sh"
hotkey-overlay {
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
// Animace žijí v power-mode.kdl, přepíná je rp-power (režim gaming je vypíná).
include optional=true "~/.config/niri/power-mode.kdl"
// Pozn.: dřív tu bylo namespace="^wallpaper$", což nesedělo na nic — awww-daemon
// registruje vrstvu pod svým vlastním jménem, takže se backdrop neuplatňoval.
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}
// Video wallpaper: mpvpaper runs in the background layer (wallpaper-video-ctl.sh)
// so it can join the backdrop too — xray blur then follows the playing video
// instead of showing awww's static first frame underneath it.
layer-rule {
    match namespace="^mpvpaper$"
    place-within-backdrop true
}
// Blur behind fuzzel. The radius must match its own corner radius
// (templates/fuzzel.ini `radius`), otherwise the blurred rectangle pokes out past
// the rounded corners. mako gets no blur: it draws all notifications into one
// surface with `margin` *inside* it, so the blur filled a frame around and a band
// between the bubbles — the odd border. Its background is 93 % opaque anyway.
// waybar is left out on purpose: its surface is a full-width transparent strip
// with floating pills, so blurring it would smear a band across the whole top.
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 12
    background-effect {
        blur true
    }
}
// Launcher and session menu (quickshell): full-screen like the wallpaper picker,
// windows underneath blurred for real (xray off).
layer-rule {
    match namespace="^rp-overlay$"
    background-effect {
        blur true
        xray false
    }
}
// Mod+Tab / Alt+Tab switchers and the Mod+D launcher (quickshell) need no rule:
// they request their own blur shape via ext-background-effect (PopAnim.qml), so
// it can follow the card while it scales in/out. `blur true` here would blur the
// whole surface at full size from the first frame of the open animation.
// Wallpaper picker (quickshell): xray off, so the windows under the overlay get
// blurred instead of being replaced by the blurred wallpaper. The preview of the
// picked wallpaper sits below the windows (rp-wallpaper-preview, Bottom layer).
layer-rule {
    match namespace="^rp-wallpaper-picker$"
    background-effect {
        blur true
        xray false
    }
}
window-rule {
    match app-id="^wine" title="^Rockstar Games Launcher$"
    match app-id="^wine" title="^Grand Theft Auto V$"
    
    open-floating true
}
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
}
window-rule {
    match app-id=r#"^nm-connection-editor$"#
    open-floating true
}
window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
}
// Pozor na velikost písmen: skutečné app-id je "Spotify", ne "spotify",
// a niri porovnává regexem citlivým na velikost — bez (?i) pravidlo nesedlo.
// (Pod nativním Waylandem hlásí Spotify "spotify" malým, takže (?i) drží obojí.)
//
// Průhlednost tady musí dělat kompozitor, na rozdíl od Vesktopu. Vesktop je
// Electron a v settings.json má `transparent: true`, čímž si sám vyrobí okno
// s alfa kanálem; CSS pak jen odkryje kořenové plochy. Spotify je CEF a žádný
// takový přepínač nemá — změřeno na třech cestách, ve všech zůstalo okno krycí
// (korelace pixelů s tapetou r ≈ -0,06, čili nula):
//   1) X11/XWayland + --enable-transparent-visuals
//   2) nativní Wayland (--ozone-platform=wayland)
//   3) --default-background-color=00000000 na obou
// Kontrola, že CSS vůbec zabírá, proběhla přes dočasné #ff0000 — okno zčervenalo.
//
// Zbývá tedy `opacity`, a ta má jednu daň: prosvítí celé okno včetně textu,
// ne jen pozadí jako v GTK. Rozdělit to nejde — kompozitor vidí jen hotové
// pixely okna a text od pozadí v nich nerozezná. Hodnota je schválně stejná
// jako `background_opacity` v kitty, aby rice držel jednu průhlednost.
//
// Zkoušelo se i obejít to rozmazanou tapetou vepsanou do CSS (okno by zůstalo
// krycí a průhledné by vypadalo jen pozadí). Text tak sice ostrý byl, ale
// celkově to vypadalo hůř, tak se to zahodilo.
window-rule {
    match app-id="(?i)^spotify$"
    opacity 0.75
    draw-border-with-background false
    background-effect {
        blur true
    }
}
// niri kreslí focus-ring za oknem, a u oken s CSD jako vyplněný obdélník, ne
// jako dutý prstenec. Zed má průhledné pozadí, takže se skrz něj místo tapety
// dívá právě ten obdélník — a protože je aktivní barva jasný gradient
// (#7aa2ff → #9d7cff) a neaktivní tmavá (#4f4568), vypadá to, jako by
// průhlednost mizela přesně ve chvíli, kdy okno dostane focus.
// Thunar se to netýká: prefer-no-csd + MiscUseCsd=FALSE mu dávají SSD.
// Vesktop má stejný problém ze stejného důvodu — frameless:true v jeho
// nastavení znamená CSD, takže mu focus-ring prosvítá průhledným pozadím.
window-rule {
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^vesktop$"#
    draw-border-with-background false
    background-effect {
        blur true
    }
}
// Settings okno (quickshell Settings.qml): plovoucí, zaoblené. Blur si žádá
// samo přes ext-background-effect, okno má 86% průhledné pozadí.
window-rule {
    match title="^RPRice Settings$"
    open-floating true
    geometry-corner-radius 16
    clip-to-geometry true
}
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}
/-window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Mod+O: zoomed further out than the default 0.5, so more workspaces fit.
overview {
    zoom 0.35
}

// Alt+Tab is the quickshell window switcher (WindowSwitcher.qml, see binds),
// so niri's built-in one is off — otherwise its defaults would also grab Mod+Tab.
recent-windows {
    off
}

binds {
	Mod+Shift+A { spawn "~/.local/bin/wl-ocr/fastscreen.sh"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+E hotkey-overlay-title="File Manager: yazi" { spawn "kitty" "--" "yazi"; }
    // quickshell Launcher.qml; fuzzel only when quickshell isn't running
    Mod+D hotkey-overlay-title="Run an Application" { spawn-sh "~/.local/bin/rp-shell launcher toggle || fuzzel"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "~/.local/bin/volume-osd.sh" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "~/.local/bin/volume-osd.sh" "down"; }
    XF86AudioMute        allow-when-locked=true { spawn "~/.local/bin/volume-osd.sh" "mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "~/.local/bin/brightness-osd.sh" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "~/.local/bin/brightness-osd.sh" "down"; }
    Mod+O repeat=false { toggle-overview; }
    // Workspace switcher (quickshell WorkspaceSwitcher.qml): hold Mod, Tab cycles,
    // releasing Mod switches. Mod+O stays the overview.
    Mod+Tab       { spawn "~/.local/bin/rp-shell" "workspaces" "next"; }
    Mod+Shift+Tab { spawn "~/.local/bin/rp-shell" "workspaces" "prev"; }
    // Window switcher, same style: hold Alt, Tab cycles, release switches.
    // Alt+` limits it to windows of the focused app.
    Alt+Tab         { spawn "~/.local/bin/rp-shell" "windows" "next"; }
    Alt+Shift+Tab   { spawn "~/.local/bin/rp-shell" "windows" "prev"; }
    Alt+grave       { spawn "~/.local/bin/rp-shell" "windows" "next-app"; }
    Alt+Shift+grave { spawn "~/.local/bin/rp-shell" "windows" "prev-app"; }
    Mod+Q repeat=false { close-window; }
    Mod+Left  { focus-column-left; }
    // Down/up moves between windows stacked in a column; past the last one it
    // continues to the next workspace.
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+L     { focus-column-right; }
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Alt+Left  { focus-monitor-left; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Alt+H     { focus-monitor-left; }
    Mod+Alt+L     { focus-monitor-right; }
    Mod+Alt+Page_Down { focus-workspace-down; }
    Mod+Alt+Page_Up   { focus-workspace-up; }
    Mod+Alt+J         { focus-workspace-down; }
    Mod+Alt+K         { focus-workspace-up; }
    Mod+Alt+Shift+Left  { move-workspace-to-monitor-left; }
    Mod+Alt+Shift+Right { move-workspace-to-monitor-right; }
    Mod+Alt+Shift+H     { move-workspace-to-monitor-left; }
    Mod+Alt+Shift+L     { move-workspace-to-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    mod+shift+1 { move-column-to-workspace 1; }
    mod+shift+2 { move-column-to-workspace 2; }
    mod+shift+3 { move-column-to-workspace 3; }
    mod+shift+4 { move-column-to-workspace 4; }
    mod+shift+5 { move-column-to-workspace 5; }
    mod+shift+6 { move-column-to-workspace 6; }
    mod+shift+7 { move-column-to-workspace 7; }
    mod+shift+8 { move-column-to-workspace 8; }
    mod+shift+9 { move-column-to-workspace 9; }
    Mod+plus { focus-workspace 1; }
    Mod+ecaron { focus-workspace 2; }
    Mod+scaron { focus-workspace 3; }
    Mod+ccaron { focus-workspace 4; }
    Mod+rcaron { focus-workspace 5; }
    Mod+zcaron { focus-workspace 6; }
    Mod+yacute { focus-workspace 7; }
    Mod+aacute { focus-workspace 8; }
    Mod+iacute { focus-workspace 9; }
    mod+shift+plus { move-column-to-workspace 1; }
    mod+shift+ecaron { move-column-to-workspace 2; }
    mod+shift+scaron { move-column-to-workspace 3; }
    mod+shift+ccaron { move-column-to-workspace 4; }
    mod+shift+rcaron { move-column-to-workspace 5; }
    mod+shift+zcaron { move-column-to-workspace 6; }
    mod+shift+yacute { move-column-to-workspace 7; }
    mod+shift+aacute { move-column-to-workspace 8; }
    mod+shift+iacute { move-column-to-workspace 9; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Space       { spawn "~/.local/bin/keyboard-layout-osd.sh" "next"; }
    // niri's own screenshot UI instead of slurp+grim: it renders a captured
    // snapshot, so the screen is frozen while you drag out the region. Saves to
    // screenshot-path and copies to the clipboard, same as the old script did.
    Print { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print { screenshot; }
    Alt+Print { screenshot; }
    // rp-shell napřímo (pár ms); rofi jen když quickshell neběží.
    Mod+Shift+W { spawn-sh "~/.local/bin/rp-shell wallpaper toggle || ~/.local/bin/pick-wallpaper.sh --rofi"; }
    Mod+Shift+D hotkey-overlay-title="Dashboard: quickshell" { spawn "qs" "ipc" "call" "dashboard" "toggle"; }
    Mod+Shift+O hotkey-overlay-title="Přepínač výstupu zvuku" { spawn "qs" "ipc" "call" "audio" "toggle"; }
    Mod+Ctrl+O hotkey-overlay-title="Další výstup zvuku" { spawn "qs" "ipc" "call" "audio" "next"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // quickshell SessionMenu.qml (lock/suspend/log out/restart/shut down);
    // falls back to niri's own exit dialog. Ctrl+Alt+Delete always gets that.
    // Clipboard history (quickshell ClipboardHistory.qml + cliphist)
    Mod+Ctrl+V { spawn "~/.local/bin/rp-shell" "clipboard" "toggle"; }
    Mod+Shift+E { spawn-sh "~/.local/bin/rp-shell session toggle || niri msg action quit"; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+S hotkey-overlay-title="Settings: quickshell" { spawn "~/.local/bin/rp-shell" "settings" "toggle"; }
}

// Displeje visí na AMD iGPU, ale niri renderovalo na NVIDII — každý snímek se
// tak kopíroval přes PCIe a při animované tapetě to shazovalo plynulost celé
// plochy. Cesta přes by-path je stabilní, číslování renderD* se může měnit.
debug {
    render-drm-device "/dev/dri/by-path/pci-0000:06:00.0-render"
}

// Okno Settings (quickshell Settings.qml → rp-settings): mezery, focus ring, stín,
// zaoblení, touchpad… Generovaný soubor (gitignored), kanonické hodnoty jsou
// v ~/.config/niri-rice/settings.json. Musí být poslední, ať přepíše layout výš.
include optional=true "~/.config/niri/settings.kdl"
