{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "modules-left": [
    "niri/workspaces",
    "niri/window",
    "custom/cava-music",
    "custom/player",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/network",
    "custom/vpn",
    "group/hardware",
    "group/audio-peripherals",
    "tray",
    "custom/power",
  ],
  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "custom/gpu", "memory", "temperature"],
  },
  "group/audio-peripherals": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "battery", "backlight"],
  },
  "niri/workspaces": {
    "format": "{icon}",
    "hide-empty": true,
    "format-icons": {
      "active": "",
      "default": "",
    },
  },
  "niri/window": {
    "max-length": 50,
    "format-empty": "",
  },
  "clock": {
    "format": "  {:%d.%m. %H:%M}",
  },
  "cpu": { "format": " {usage}%" },
  "memory": { "format": " {}%" },
  "temperature": {
    "format": " {temperatureC}°C",
    "critical-threshold": 85,
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " ",
    "format-icons": { "default": ["", "", ""] },
    "tooltip-format": "{desc}\n{volume} %",
    // levý = přepínač výstupů, pravý = Settings → Sound, prostřední = ztlumit
    "on-click": "~/.local/bin/rp-shell audio toggle",
    "on-click-right": "~/.local/bin/rp-shell settings sound",
    "on-click-middle": "~/.local/bin/rp-audio mute",
    // kolečko mění hlasitost na všech výstupech naráz
    "on-scroll-up": "~/.local/bin/rp-audio volume up",
    "on-scroll-down": "~/.local/bin/rp-audio volume down",
  },
  "backlight": { "format": "󰃟 {percent}%" },
  "custom/network": {
    // The built-in "network" module, without "interface" set, auto-selects
    // by lowest default-route metric across IPv4 and IPv6 combined (the
    // netlink route dump goes out as AF_UNSPEC and nothing filters by
    // family afterwards - a waybar bug, see Alexays/Waybar
    // src/modules/network.cpp). ProtonVPN's IPv6 leak protection keeps a
    // default IPv6 route on the dummy ipv6leakintrf0 interface with a lower
    // metric than the real IPv4 default route, so after connecting the VPN
    // the module sometimes latched onto it and showed
    // "ipv6leakintrf0 (no IP)" instead of the real ethernet/wifi. This
    // script only looks at the IPv4 default route instead, so that
    // IP-less dummy interface can never win - see waybar-network.sh.
    "exec": "~/.local/bin/waybar-network.sh",
    "interval": 2,
    "return-type": "json",
    "on-click": "~/.local/bin/rp-shell network toggle",
    "max-length": 30,
  },
  "custom/vpn": {
    "on-click": "~/.local/bin/protonvpn-app",
    "exec": "~/.local/bin/waybar-vpn.sh",
    "interval": 5,
    "return-type": "json",
    "format": "{text}",
    "max-length": 14,
    "hide-empty-text": true,
    "tooltip": true,
  },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    // levý klik = přepínač power režimů (rp-power)
    "on-click": "~/.local/bin/rp-shell power toggle",
    "tooltip-format": "{capacity} % {time}\nClick to switch power mode",
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
  },
  "tray": { "icon-size": 16, "spacing": 10 },

  "custom/start-menu": {
    "format": "󰍜",
    "tooltip": false,
    "on-click": "~/.config/eww/scripts/toggle_start_menu.sh",
  },
  "custom/niri-settings": {
    "format": "󰒓",
    "tooltip": false,
    "on-click": "~/.config/eww/scripts/toggle_niri_quick.sh",
  },
  "custom/cava-music": {
    "exec": "~/.local/bin/waybar-cava-stream.sh",
    "tooltip": false,
  },
  "custom/player": {
    "max-length": 40,
    "exec": "playerctl metadata --format '♫ {{artist}} - {{title}}' --follow",
    "tooltip": false,
  },
  "custom/kb-layout": {
    "exec": "bash -lc 'layout=$(niri msg keyboard-layouts 2>/dev/null | awk \"/^\\*/{print \\$2; exit}\"); [ -n \"$layout\" ] && printf \"⌨ %s\" \"$layout\" || printf \"⌨ ?\"'",
    "interval": 2,
    "tooltip": false,
  },
  "custom/gpu": {
    "exec": "~/.local/bin/waybar-gpu.sh",
    "return-type": "json",
    "interval": 3,
    "tooltip": true,
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.local/bin/rp-shell dashboard toggle",
  },
}
