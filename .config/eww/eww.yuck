;; --- PROMĚNNÉ ---
;; Čas a datum
(defpoll time_hours :interval "1s" "date '+%H'")
(defpoll time_mins :interval "1s" "date '+%M'")
(defpoll date_full :interval "1h" "date '+%A, %d. %B %Y'")
(defpoll uptime :interval "1m" "uptime -p | sed 's/up //'")
(defpoll username :interval "24h" "whoami")

;; Systém a Média
(defpoll vol_level :interval "1s" "sh -c 'v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk \"{print int(\\$2 * 100)}\"); if [ -n \"$v\" ]; then echo \"$v\"; else echo 0; fi'")
(defpoll mic_level :interval "1s" "sh -c 'v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | awk \"{print int(\\$2 * 100)}\"); if [ -n \"$v\" ]; then echo \"$v\"; else echo 0; fi'")
(defpoll brightness :interval "1s" "sh -c 'v=$(brightnessctl -m 2>/dev/null | awk -F, \"{print substr(\\$4, 0, length(\\$4)-1)}\"); if [ -n \"$v\" ]; then echo \"$v\"; else echo 0; fi'")
(defpoll battery :interval "30s" "sh -c 'cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n 1 || echo 0'")
(defpoll music_title :interval "2s" "playerctl metadata title 2>/dev/null || echo 'Nic nehraje'")
(defpoll music_artist :interval "2s" "playerctl metadata artist 2>/dev/null || echo 'Žádný interpret'")
(defpoll music_status :interval "1s" "playerctl status 2>/dev/null")
(deflisten cava_bars :initial "" "~/.config/eww/scripts/cava.sh")

;; Počasí (vrací JSON)
(defpoll weather_data :interval "15m" "~/.config/eww/scripts/weather.sh")
(defpoll kb_layout :interval "2s" "bash -lc 'layout=$(niri msg keyboard-layouts 2>/dev/null | awk \"/^\\*/{print \\$2; exit}\"); if [ -n \"$layout\" ]; then echo \"$layout\"; else echo ?; fi'")
(defpoll overview_state :interval "2s" "niri msg overview-state 2>/dev/null || echo unknown")

(include "./widgets/start-menu.yuck")
(include "./widgets/niri-quick.yuck")

;; --- WIDGETY ---

;; 1. PROFIL A POZDRAV
(defwidget profile []
  (box :class "card profile-card" :orientation "h" :space-evenly false :spacing 15
    (box :class "avatar")
    (box :orientation "v" :space-evenly false :valign "center"
      (label :class "greeting" :text "Ahoj, ${username}!" :halign "start")
      (label :class "uptime" :text "Uptime: ${uptime}" :halign "start")
    )
  )
)

;; 2. HODINY A POČASÍ
(defwidget time_weather []
  (box :class "card time-weather-card" :orientation "h" :space-evenly true
    (box :orientation "v" :space-evenly false :halign "center" :valign "center"
      (box :orientation "h" :space-evenly false :spacing 5 :halign "center"
        (label :class "time-hours" :text time_hours)
        (label :class "time-mins" :text time_mins)
      )
      (label :class "date-text" :text date_full)
    )
    (box :orientation "v" :space-evenly false :halign "center" :valign "center"
      (label :class "weather-temp" :text "${weather_data.temp}")
      (label :class "weather-desc" :text "${weather_data.desc}")
    )
  )
)

;; 3. RYCHLÉ APLIKACE (Start menu feel)
(defwidget quick_apps []
  (box :class "card apps-card" :orientation "v" :space-evenly false :spacing 15
    (label :class "section-title" :text "Oblíbené aplikace" :halign "start")
    (box :orientation "h" :space-evenly true :spacing 10
      (button :class "app-btn" :onclick "firefox & eww close dashboard" "󰈹")
      (button :class "app-btn" :onclick "kitty & eww close dashboard" "")
      (button :class "app-btn" :onclick "thunar & eww close dashboard" "󰉋")
      (button :class "app-btn" :onclick "code & eww close dashboard" "󰨞")
      (button :class "app-btn" :onclick "spotify & eww close dashboard" "󰓇")
      (button :class "app-btn" :onclick "vesktop & eww close dashboard" "󰙯")
    )
  )
)

;; 4. MÉDIA
(defwidget media_player []
  (box :class "card media-card" :orientation "v" :space-evenly false :spacing 10
    (label :class "music-title" :text music_title :limit-width 30 :halign "start")
    (label :class "music-artist" :text music_artist :limit-width 30 :halign "start")
    (label :class "cava-bars" :text cava_bars :halign "center" :vexpand true)
    (box :class "media-controls" :orientation "h" :space-evenly true :spacing 10
      (button :class "media-btn" :onclick "playerctl previous" "󰒮")
      (button :class "media-btn play" :onclick "playerctl play-pause" {music_status == "Playing" ? "󰏤" : "󰐊"})
      (button :class "media-btn" :onclick "playerctl next" "󰒭")
    )
  )
)

;; 5. POSUVNÍKY A SYSTÉM
(defwidget system_sliders []
  (box :class "card sliders-card" :orientation "v" :space-evenly false :spacing 15
    ;; Hlasitost
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "slider-icon" :text "󰕾")
      (scale :class "sys-slider vol" :value vol_level :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%" :max 101 :min 0 :hexpand true)
    )
    ;; Mikrofon
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "slider-icon" :text "󰍬")
      (scale :class "sys-slider mic" :value mic_level :onchange "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {}%" :max 101 :min 0 :hexpand true)
    )
    ;; Jas
    (box :orientation "h" :space-evenly false :spacing 10
      (label :class "slider-icon" :text "󰃠")
      (scale :class "sys-slider bri" :value brightness :onchange "brightnessctl s {}%" :max 101 :min 0 :hexpand true)
    )
  )
)

;; 6. STATISTIKY (Měřiče)
(defwidget stats []
  (box :class "card stats-card" :orientation "h" :space-evenly true :spacing 10
    (box :orientation "v" :space-evenly false :spacing 5
      (circular-progress :class "circ bat" :value battery :thickness 8 (label :text "󰁹" :class "circ-icon"))
      (label :class "stat-lbl" :text "BAT")
    )
    (box :orientation "v" :space-evenly false :spacing 5
      (circular-progress :class "circ cpu" :value {EWW_CPU.avg} :thickness 8 (label :text "󰻠" :class "circ-icon"))
      (label :class "stat-lbl" :text "CPU")
    )
    (box :orientation "v" :space-evenly false :spacing 5
      (circular-progress :class "circ ram" :value {EWW_RAM.used_mem_perc} :thickness 8 (label :text "󰍛" :class "circ-icon"))
      (label :class "stat-lbl" :text "RAM")
    )
  )
)

;; 7. KALENDÁŘ A NAPÁJENÍ
(defwidget cal_power []
  (box :orientation "v" :space-evenly false :spacing 15
    (box :class "card cal-card"
      (calendar :class "calendar-widget")
    )
    (box :class "card power-card" :orientation "h" :space-evenly true
      (button :class "pwr-btn" :onclick "niri msg action quit" "󰗼")
      (button :class "pwr-btn" :onclick "systemctl suspend" "󰤄")
      (button :class "pwr-btn" :onclick "systemctl reboot" "󰜉")
      (button :class "pwr-btn shutdown" :onclick "systemctl poweroff" "󰐥")
    )
  )
)

;; --- HLAVNÍ ROZLOŽENÍ ---
(defwidget control_center []
  (box :class "dashboard-container" :orientation "h" :space-evenly false :spacing 15
    ;; Levý sloupec
    (box :orientation "v" :space-evenly false :spacing 15 :width 350
      (profile)
      (time_weather)
      (quick_apps)
      (system_sliders)
    )
    ;; Pravý sloupec
    (box :orientation "v" :space-evenly false :spacing 15 :width 300
      (media_player)
      (stats)
      (cal_power)
    )
  )
)

;; --- OKNO ---
(defwindow dashboard
  :monitor 0
  :geometry (geometry :x "15px" :y "15px" :width "680px" :height "650px" :anchor "top left")
  :stacking "fg"
  :exclusive false
  (control_center)
)
