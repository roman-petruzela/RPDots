#!/usr/bin/env bash
set -euo pipefail
FLAG="$HOME/.config/niri-rice/bar"
mkdir -p "$(dirname "$FLAG")"

case "${1:-}" in
    "") cat "$FLAG" 2>/dev/null || echo waybar ;;
    use)
        case "${2:-}" in
            waybar)
                echo waybar > "$FLAG"
                systemctl --user start waybar.service ;;
            quickshell)
                echo quickshell > "$FLAG"
                systemctl --user stop waybar.service ;;
            *) echo "usage: rp-bar use waybar|quickshell" >&2; exit 1 ;;
        esac ;;
    test)
        [[ -n "${2:-}" ]] || { echo "usage: rp-bar test <output>" >&2; exit 1; }
        echo "test:$2" > "$FLAG" ;;
    *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
