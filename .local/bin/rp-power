#!/usr/bin/env bash
# rp-power — přepínání power režimů RPRice.
#
#   rp-power battery    šetřicí: CPU powersave, dGPU omezená a nechaná spát,
#                        video tapeta uspaná
#   rp-power balanced   běžná práce (výchozí)
#   rp-power gaming     plný výkon + zámek taktu dGPU + uspaná video tapeta
#   rp-power status     co je teď nastavené
#   rp-power sync       interní — dorovná session efekty (video tapeta) podle
#                        aktuálně platného režimu; volá ho path unit při AC
#                        události, není určeno k ručnímu spouštění
#
# Privilegovanou část (CPU, ACPI profil, nvidia-smi) dělá /usr/local/bin/rp-power-apply
# přes sudo. Tady zůstávají jen věci ze session — hlavně animace niri a video tapeta.
set -uo pipefail

HELPER=/usr/local/bin/rp-power-apply
NIRI_KDL="$HOME/.config/niri/power-mode.kdl"
STATE_FILE=/var/lib/rp-power/mode
# Skutečně aplikovaný režim — na baterce se může lišit od STATE_FILE, protože
# odpojení AC vynutí "battery" bez ohledu na to, co má uživatel vybrané (viz
# rp-power-apply). Zapisuje ho výhradně rp-power-apply.
EFFECTIVE_FILE=/var/lib/rp-power/effective
VIDEO_CTL="$HOME/.local/bin/wallpaper-video-ctl.sh"

# Video tapeta se dekóduje a překresluje na iGPU — tedy na té samé, která zároveň
# přebírá každý snímek hry z dGPU. V gaming režimu ji proto uspíme kvůli výkonu;
# na baterce kvůli spotřebě (dekód videa stojí citelně víc než statický obrázek).
# Statická awww vrstva zůstane, takže plocha jen zamrzne na prvním snímku.
switch_wallpaper_video() {
    [[ -x "$VIDEO_CTL" ]] || return 0
    case "$1" in
        battery|gaming) "$VIDEO_CTL" inhibit   >/dev/null 2>&1 && echo "  video tapeta uspaná" ;;
        *)              "$VIDEO_CTL" uninhibit >/dev/null 2>&1 && echo "  video tapeta obnovená" ;;
    esac
    return 0
}

write_animations() {
    local tmp
    tmp=$(mktemp)
    {
        echo "// Generováno skriptem rp-power — needitovat ručně."
        echo "// Přepíná se přes: rp-power battery|balanced|gaming"
        cat <<'KDL'
animations {
    slowdown 1.5
    window-open {
        duration-ms 250
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 250
        curve "ease-out-expo"
    }
    window-resize {
        duration-ms 150
        curve "ease-out-expo"
    }
    workspace-switch {
        duration-ms 250
        curve "ease-out-expo"
    }
}
KDL
    } > "$tmp"

    # Nikdy nenechat rozbitý config — niri ho hot-reloaduje a rozsypal by se
    # celý desktop. Zapisovat až po validaci.
    local backup
    backup=$(mktemp)
    cp "$NIRI_KDL" "$backup" 2>/dev/null || true
    cp "$tmp" "$NIRI_KDL"
    if ! niri validate >/dev/null 2>&1; then
        echo "  !! niri config by byl neplatný, vracím původní animace" >&2
        cp "$backup" "$NIRI_KDL" 2>/dev/null || true
        rm -f "$tmp" "$backup"
        return 1
    fi
    rm -f "$tmp" "$backup"
    echo "  animace niri zapnuté"
    return 0
}

status() {
    local ac gov epp prof mode
    ac=$(cat /sys/class/power_supply/ACAD/online 2>/dev/null)
    gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
    epp=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null)
    prof=$(cat /sys/firmware/acpi/platform_profile 2>/dev/null)
    # EFFECTIVE_FILE odráží to, co je fakticky aplikované (viz komentář výše);
    # dokud nevznikne (první běh před instalací rp-power-apply), padáme na
    # zvolený režim.
    mode=$(cat "$EFFECTIVE_FILE" 2>/dev/null || cat "$STATE_FILE" 2>/dev/null || echo "?")

    echo "režim:            $mode"
    echo "napájení:         $([[ "$ac" == "1" ]] && echo 'síť' || echo 'baterie')"
    echo "ACPI profil:      $prof"
    echo "CPU governor:     $gov (EPP: $epp)"

    local inh="${XDG_CACHE_HOME:-$HOME/.cache}/niri-rice/video-inhibit"
    if [[ -f "$inh" ]]; then
        echo "video tapeta:     uspaná"
    elif pgrep -x mpvpaper >/dev/null 2>&1; then
        echo "video tapeta:     přehrává se"
    else
        echo "video tapeta:     žádná"
    fi

    local rt
    rt=$(cat /sys/bus/pci/devices/0000:01:00.0/power/runtime_status 2>/dev/null)
    if [[ "$rt" == "suspended" ]]; then
        echo "dGPU:             spí (0 W)"
    elif command -v nvidia-smi >/dev/null 2>&1; then
        echo "dGPU:             $(nvidia-smi --query-gpu=pstate,clocks.gr,power.draw,power.limit --format=csv,noheader 2>/dev/null)"
    fi
}

case "${1:-status}" in
    status)
        status
        ;;
    battery|balanced|gaming)
        write_animations
        switch_wallpaper_video "$1"
        sudo -n "$HELPER" "$1" || {
            echo "  !! sudo selhalo — je nainstalované /etc/sudoers.d/rp-power?" >&2
            exit 1
        }
        ;;
    sync)
        # Voláno path unitem při změně EFFECTIVE_FILE (AC plug/unplug) — jen
        # dorovná session efekty, bez sudo a beze změny STATE_FILE.
        switch_wallpaper_video "$(cat "$EFFECTIVE_FILE" 2>/dev/null || cat "$STATE_FILE" 2>/dev/null || echo balanced)"
        ;;
    *)
        echo "použití: rp-power {battery|balanced|gaming|status}" >&2
        exit 1
        ;;
esac
