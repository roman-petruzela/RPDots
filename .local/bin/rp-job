#!/usr/bin/env bash
set -uo pipefail

DIR="${XDG_RUNTIME_DIR:-/tmp}/rp-job"
LOG="$DIR/log"
META="$DIR/meta.json"
PIDF="$DIR/pid"
CODEF="$DIR/code"

die() { echo "rp-job: $*" >&2; exit 1; }

running() { [[ -f "$PIDF" ]] && kill -0 "$(cat "$PIDF")" 2>/dev/null; }

case "${1:-status}" in
    start)
        shift
        [[ $# -ge 4 && "$3" == "--" ]] || die "usage: rp-job start <title> <terminal-json> -- <command…>"
        title=$1 term=$2
        shift 3
        running && die "another action is still running"
        mkdir -p "$DIR"
        : > "$LOG"
        rm -f "$CODEF"
        jq -n --arg t "$title" --argjson term "$term" --arg started "$(date +%s)" \
            '{ title: $t, terminal: $term, started: ($started | tonumber) }' > "$META"
        LOG="$LOG" CODEF="$CODEF" setsid bash -c '
            "$@" >>"$LOG" 2>&1 </dev/null
            c=$?
            echo "── exit $c ──" >>"$LOG"
            echo "$c" >"$CODEF"
        ' _ "$@" </dev/null >/dev/null 2>&1 &
        echo $! > "$PIDF"
        ;;
    status)
        if [[ ! -f "$META" ]]; then echo '{}'; exit 0; fi
        jq --argjson running "$(running && echo true || echo false)" \
           --arg code "$(cat "$CODEF" 2>/dev/null)" --arg log "$LOG" \
           '. + { running: $running, code: ($code | tonumber? // null), log: $log }' "$META"
        ;;
    dismiss)
        running && die "still running"
        rm -f "$META" "$CODEF" "$PIDF" "$LOG"
        ;;
    *) cat >&2 <<'EOF'
usage: rp-job start <title> <terminal-json> -- <cmd...>
       rp-job status
       rp-job dismiss
EOF
        exit 1 ;;
esac
