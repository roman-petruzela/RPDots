#!/usr/bin/env python3
import fcntl
import glob
import os
import sys

KEYS = (56, 100)
EVIOCGKEY = (2 << 30) | (96 << 16) | (ord("E") << 8) | 0x18

readable = False
for dev in glob.glob("/dev/input/event*"):
    try:
        fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        continue
    try:
        state = fcntl.ioctl(fd, EVIOCGKEY, bytes(96))
    except OSError:
        continue
    finally:
        os.close(fd)
    readable = True
    if any(state[k // 8] >> (k % 8) & 1 for k in KEYS):
        sys.exit(0)
sys.exit(1 if readable else 2)
