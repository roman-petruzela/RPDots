#!/usr/bin/env bash
sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rp-shell.sock"
if [[ -S "$sock" ]] && command -v socat >/dev/null 2>&1 \
    && printf '%s\n' "$*" | socat -t 0.5 - "UNIX-CONNECT:$sock" 2>/dev/null; then
    exit 0
fi
command -v qs >/dev/null 2>&1 && exec qs ipc call "$@" >/dev/null 2>&1
exit 1
