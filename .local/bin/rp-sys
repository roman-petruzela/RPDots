#!/usr/bin/env bash
set -uo pipefail
export LC_ALL=C

die() { echo "rp-sys: $*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

PACMAN_FLAGS=(--noconfirm --noprogressbar --color never)

info() {
    local os kernel host up cpu cores gpu mem swap disks outputs
    os=$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Linux}")
    kernel=$(uname -r)
    host=$(cat /etc/hostname 2>/dev/null || uname -n)
    up=$(awk '{ d=int($1/86400); h=int($1%86400/3600); m=int($1%3600/60);
                if (d) printf "%dd %dh %dm", d, h, m; else if (h) printf "%dh %dm", h, m; else printf "%dm", m }' /proc/uptime)
    cpu=$(awk -F': ' '/^model name/ { print $2; exit }' /proc/cpuinfo)
    cores=$(nproc)
    gpu=$(lspci 2>/dev/null | grep -Ei 'vga|3d|display' | sed -E 's/^[0-9a-f:.]+ [^:]+: //; s/ \(rev [0-9a-f]+\)//' | jq -R . | jq -s .)
    mem=$(awk '/^MemTotal/ { t=$2 } /^MemAvailable/ { a=$2 } /^SwapTotal/ { st=$2 } /^SwapFree/ { sf=$2 }
               END { printf "{\"total\":%d,\"used\":%d,\"swapTotal\":%d,\"swapUsed\":%d}", t*1024, (t-a)*1024, st*1024, (st-sf)*1024 }' /proc/meminfo)
    disks=$(df -B1 --output=target,size,used,fstype -x tmpfs -x devtmpfs -x efivarfs -x overlay 2>/dev/null |
        awk 'NR > 1 && $1 !~ /^\/(boot|efi|var\/lib|snap)/' |
        jq -R 'split(" ") | map(select(length > 0)) | { mount: .[0], size: (.[1] | tonumber), used: (.[2] | tonumber), fs: .[3] }' |
        jq -s 'unique_by(.size, .used)')
    outputs=$(niri msg --json outputs 2>/dev/null | jq '[to_entries[] | .value | {
        name, model: ((.make // "") + " " + (.model // "") | ltrimstr(" ")),
        mode: (if .current_mode != null then .modes[.current_mode] | "\(.width)×\(.height) @ \(.refresh_rate / 1000 | . * 10 | round / 10) Hz" else "off" end),
        scale: (.logical.scale // 1) }]' 2>/dev/null || echo '[]')

    local bat="null"
    local b; for b in /sys/class/power_supply/BAT*; do
        [[ -d "$b" ]] || continue
        bat=$(jq -n --arg cap "$(cat "$b/capacity" 2>/dev/null)" --arg st "$(cat "$b/status" 2>/dev/null)" \
                    --arg full "$(cat "$b/energy_full" 2>/dev/null || cat "$b/charge_full" 2>/dev/null)" \
                    --arg design "$(cat "$b/energy_full_design" 2>/dev/null || cat "$b/charge_full_design" 2>/dev/null)" \
            '{ capacity: ($cap | tonumber? // null), status: $st,
               health: (if ($full | tonumber?) and ($design | tonumber? // 0) > 0
                        then ($full | tonumber) * 100 / ($design | tonumber) | round else null end) }')
        break
    done

    jq -n --arg os "$os" --arg kernel "$kernel" --arg host "$host" --arg user "$USER" --arg up "$up" \
          --arg cpu "$cpu" --argjson cores "$cores" --argjson gpu "$gpu" --argjson mem "$mem" \
          --argjson disks "$disks" --argjson outputs "$outputs" --argjson battery "$bat" \
          --arg niri "$(niri --version 2>/dev/null | awk '{ print $2 }')" \
          --arg qs "$(LC_ALL=C.UTF-8 qs --version 2>/dev/null | awk '{ print $2 }')" \
          --arg shell "$(basename "${SHELL:-}") $(${SHELL:-sh} --version 2>/dev/null | grep -oE '[0-9]+\.[0-9.]+' | head -1)" \
          --arg board "$(cat /sys/class/dmi/id/product_name 2>/dev/null) $(cat /sys/class/dmi/id/product_version 2>/dev/null)" \
          --arg vendor "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" \
          --arg pkgs "$(pacman -Qq 2>/dev/null | wc -l)" --arg aur "$(pacman -Qqm 2>/dev/null | wc -l)" \
          --arg flat "$( has flatpak && flatpak list --app 2>/dev/null | wc -l || echo 0)" \
          --arg boot "$(uptime -s 2>/dev/null)" \
    '{ os: $os, kernel: $kernel, host: $host, user: $user, uptime: $up, boot: $boot,
       cpu: $cpu, cores: $cores, gpu: $gpu, memory: $mem, disks: $disks, outputs: $outputs,
       battery: $battery, niri: $niri, quickshell: $qs, shell: $shell,
       machine: (($vendor + " " + $board) | gsub("\\s+$"; "")),
       packages: { pacman: ($pkgs | tonumber), aur: ($aur | tonumber), flatpak: ($flat | tonumber) } }'
}

repo_updates() {
    local db="${TMPDIR:-/tmp}/rp-sys-db-$UID"
    local sysdb; sysdb=$(pacman-conf DBPath 2>/dev/null || echo /var/lib/pacman/)
    mkdir -p "$db"
    exec 8>"$db.flock"
    flock -w 60 8 || return 1
    ln -sfn "${sysdb%/}/local" "$db/local"
    fakeroot -- pacman -Sy --disable-sandbox --dbpath "$db" --logfile /dev/null >/dev/null 2>&1 || return 1
    pacman -Qu --dbpath "$db" 2>/dev/null | grep -v '\[ignored\]' || true
}

updates() {
    local repo aur flat err=""
    repo=$(repo_updates) || err="Repository sync failed (offline?)"
    aur=""; has paru && aur=$(timeout 30 paru -Qua 2>/dev/null)
    flat=""; has flatpak && flat=$(timeout 30 flatpak remote-ls --updates --app --columns=application,version 2>/dev/null)
    jq -n --arg repo "$repo" --arg aur "$aur" --arg flat "$flat" --arg err "$err" --arg checked "$(date +%H:%M)" '
        def pac: split("\n") | map(select(length > 0) | capture("^(?<name>\\S+) (?<old>\\S+) -> (?<new>\\S+)"));
        { repo: ($repo | pac), aur: ($aur | pac),
          flatpak: ($flat | split("\n") | map(select(length > 0) | split("\t") | { name: .[0], old: "", new: (.[1] // "") })),
          error: $err, checked: $checked }'
}

packages() {
    local foreign; foreign=$(pacman -Qqm 2>/dev/null | paste -sd' ' -)
    local orphans; orphans=$(pacman -Qqdt 2>/dev/null | paste -sd' ' -)
    {
        pacman -Qi 2>/dev/null | awk -F' *: ' '
            /^Name/ { n = $2 } /^Version/ { v = $2 } /^Description/ { d = $2 }
            /^Installed Size/ { s = $2 } /^Install Reason/ { r = ($2 ~ /Explicitly/) ? "explicit" : "dependency" }
            /^Install Date/ { t = $2 }
            /^$/ { if (n != "") printf "pacman\t%s\t%s\t%s\t%s\t%s\t%s\n", n, v, s, r, t, d; n = "" }'
        has flatpak && flatpak list --app --columns=application,version,size,name 2>/dev/null |
            awk -F'\t' '{ printf "flatpak\t%s\t%s\t%s\texplicit\t\t%s\n", $1, $2, $3, $4 }'
    } | jq -R -s --arg foreign " $foreign " --arg orphans " $orphans " '
        def bytes: capture("(?<n>[0-9.]+)[^0-9A-Za-z]?(?<u>[KMGT]?i?B)") as $m
            | ($m.n | tonumber) * ({ "B": 1, "KiB": 1024, "MiB": 1048576, "GiB": 1073741824,
                                     "kB": 1000, "MB": 1e6, "GB": 1e9, "TiB": 1099511627776 }[$m.u] // 1);
        split("\n") | map(select(length > 0) | split("\t") as $f | {
            source: $f[0], name: $f[1], version: $f[2], size: (($f[3] | bytes?) // 0),
            reason: $f[4], date: $f[5], description: ($f[6] // ""),
            aur: ($f[0] == "pacman" and ($foreign | contains(" " + $f[1] + " "))),
            orphan: ($f[0] == "pacman" and ($orphans | contains(" " + $f[1] + " "))) })'
}

pkginfo() {
    local out
    out=$(pacman -Qi "$1" 2>/dev/null || pacman -Si "$1" 2>/dev/null || (has paru && paru -Si "$1" 2>/dev/null))
    [[ -n "$out" ]] || die "package not found: $1"
    awk '
        /^[A-Za-z][A-Za-z ]*[A-Za-z] +: / { if (k != "") print k "\t" v; split($0, a, / +: /); k = a[1]; v = substr($0, index($0, ": ") + 2); next }
        /^ +/ { sub(/^ +/, ""); v = v "  " $0; next }
        END { if (k != "") print k "\t" v }' <<<"$out" |
        jq -R -s 'split("\n") | map(select(length > 0) | split("\t") | { key: .[0], value: .[1] })'
}

search() {
    local q=$1 repo aur
    repo=$(pacman -Ss "$q" 2>/dev/null | paste - - | head -150)
    aur=""; has paru && aur=$(timeout 20 paru -Ssa "$q" 2>/dev/null | paste - - | head -100)
    local installed; installed=" $(pacman -Qq | paste -sd' ' -) "
    jq -n --arg repo "$repo" --arg aur "$aur" --arg inst "$installed" '
        def parse($src): split("\n") | map(select(length > 0)
            | capture("^(?<repo>[^/]+)/(?<name>\\S+) (?<version>\\S+)[^\\t]*\\t\\s*(?<description>.*)$")?
            | . as $p | $p + { source: $src, installed: ($inst | contains(" " + $p.name + " ")) });
        ($repo | parse("repo")) + ($aur | parse("aur"))'
}

FWBUS=(busctl --system --json=short call org.fedoraproject.FirewallD1 /org/fedoraproject/FirewallD1)

fwbus() { timeout 4 "${FWBUS[@]}" "$@" 2>/dev/null | jq -c '.data[0]'; }

zone_file() {
    local z=$1
    [[ "$z" =~ ^[A-Za-z0-9_-]+$ ]] || return 1
    if [[ -r "/etc/firewalld/zones/$z.xml" ]]; then echo "/etc/firewalld/zones/$z.xml"
    elif [[ -r "/usr/lib/firewalld/zones/$z.xml" ]]; then echo "/usr/lib/firewalld/zones/$z.xml"
    else return 1; fi
}

firewall() {
    local active=false zone="" zones="{}" panic=false err="" svc="[]" ports="[]" f
    systemctl is-active --quiet firewalld && active=true
    if [[ $active == true ]]; then
        zone=$(fwbus org.fedoraproject.FirewallD1 getDefaultZone | jq -r . 2>/dev/null)
        if [[ -z "$zone" || "$zone" == null ]]; then
            err="firewalld is running but not answering on D-Bus"
            zone=""
        else
            zones=$(fwbus org.fedoraproject.FirewallD1.zone getActiveZones || echo '{}')
            panic=$(fwbus org.fedoraproject.FirewallD1 queryPanicMode || echo false)
            if f=$(zone_file "$zone"); then
                svc=$(python3 - "$f" <<'PY'
import json, sys, xml.etree.ElementTree as ET
r = ET.parse(sys.argv[1]).getroot()
print(json.dumps({
    "services": [s.get("name") for s in r.findall("service")],
    "ports": [f'{p.get("port")}/{p.get("protocol")}' for p in r.findall("port")],
}))
PY
)
                ports=$(jq -c .ports <<<"$svc"); svc=$(jq -c .services <<<"$svc")
            fi
        fi
    fi
    jq -n --argjson active "$active" --arg zone "$zone" --argjson zones "${zones:-{\}}" \
          --argjson panic "${panic:-false}" --argjson services "$svc" --argjson ports "$ports" \
          --arg err "$err" --arg ufw "$(systemctl is-active ufw 2>/dev/null)" '
        { backend: "firewalld", active: $active, responding: ($active and $err == ""), zone: $zone,
          interfaces: ($zones[$zone].interfaces // []),
          activeZones: ($zones | keys), services: $services, ports: $ports,
          panic: $panic, ufw: ($ufw == "active"), error: $err }'
}

fw_services() {
    local d
    for d in /usr/lib/firewalld/services /etc/firewalld/services; do
        [[ -d "$d" ]] && command ls "$d"
    done | sed -n 's/\.xml$//p' | sort -u | jq -R -s 'split("\n") | map(select(length > 0))'
}

fw() {
    local act=$1 arg=${2:-} zone
    case "$act" in
        restart)   exec pkexec systemctl restart firewalld ;;
        start)     exec pkexec systemctl enable --now firewalld ;;
        stop)      exec pkexec systemctl disable --now firewalld ;;
        panic-on)  exec pkexec firewall-cmd --panic-on ;;
        panic-off) exec pkexec firewall-cmd --panic-off ;;
    esac
    zone=$(fwbus org.fedoraproject.FirewallD1 getDefaultZone | jq -r .)
    [[ "$zone" =~ ^[A-Za-z0-9_-]+$ ]] || die "firewalld is not answering"
    case "$act" in
        add-service|remove-service)
            [[ "$arg" =~ ^[a-z0-9._-]+$ ]] || die "invalid service: $arg" ;;
        add-port|remove-port)
            [[ "$arg" =~ ^[0-9]{1,5}(-[0-9]{1,5})?/(tcp|udp|sctp|dccp)$ ]] || die "invalid port (use 8080/tcp or 6000-6010/udp): $arg" ;;
        *) die "unknown firewall action: $act" ;;
    esac
    echo ":: firewall-cmd --zone=$zone --$act=$arg (runtime + permanent)"
    exec pkexec sh -c 'firewall-cmd --zone="$1" --"$2"="$3" && firewall-cmd --permanent --zone="$1" --"$2"="$3"' \
        sh "$zone" "$act" "$arg"
}

valid_pkgs() {
    local p
    for p in "$@"; do [[ "$p" =~ ^[a-zA-Z0-9@._+-]+$ ]] || die "invalid package name: $p"; done
}

dsize() { du -sb "$1" 2>/dev/null | awk '{ print $1 + 0 }'; }

storage() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}" trash="$HOME/.local/share/Trash" journal core flat
    journal=$(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]' | head -1)
    core=$(dsize /var/lib/systemd/coredump)
    local caches
    caches=$(du -sb "$cache"/* 2>/dev/null | sort -rn | head -10 |
        jq -R 'split("\t") | { size: (.[0] | tonumber), path: .[1], name: (.[1] | split("/") | last) }' | jq -s .)
    df -B1 --output=target,size,used,avail,source -x tmpfs -x devtmpfs -x efivarfs -x overlay 2>/dev/null |
        awk 'NR > 1 && $1 !~ /^\/(boot|efi|var\/lib|snap|\.snapshots)/' |
        jq -R 'split(" ") | map(select(length > 0)) | { mount: .[0], size: (.[1] | tonumber), used: (.[2] | tonumber), free: (.[3] | tonumber), device: .[4] }' |
        jq -s 'unique_by(.device)' > /tmp/rp-sys-df.$$
    jq -n --slurpfile disks /tmp/rp-sys-df.$$ --argjson caches "$caches" \
          --arg trash "$(dsize "$trash")" --arg trashn "$(find "$trash/files" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)" \
          --arg cache "$(dsize "$cache")" --arg pkg "$(dsize /var/cache/pacman/pkg)" \
          --arg journal "$journal" --arg core "${core:-0}" --arg thumbs "$(dsize "$cache/thumbnails")" '
        def n: tonumber? // 0;
        { disks: $disks[0], caches: $caches,
          items: [
            { id: "trash", label: "Trash", size: ($trash | n), detail: "\($trashn) items", root: false },
            { id: "pacman", label: "Package cache", size: ($pkg | n), detail: "old versions of installed packages", root: true },
            { id: "cache", label: "App caches (~/.cache)", size: ($cache | n), detail: "per-app below", root: false },
            { id: "coredumps", label: "Crash dumps", size: ($core | n), detail: "/var/lib/systemd/coredump", root: true },
            { id: "journal", label: "System logs", size: 0, detail: ("journal takes " + $journal + "; trimmed to 50 MB"), root: true },
            { id: "flatpak", label: "Unused Flatpak runtimes", size: 0, detail: "runtimes no app needs any more", root: false }
          ] }'
    rm -f /tmp/rp-sys-df.$$
}

storage_home() {
    du -sb "$HOME"/* "$HOME"/.[!.]* 2>/dev/null | sort -rn | head -15 |
        jq -R 'split("\t") | { size: (.[0] | tonumber), path: .[1], name: (.[1] | split("/") | last) }' | jq -s .
}

clean() {
    local what=$1 arg=${2:-} cache="${XDG_CACHE_HOME:-$HOME/.cache}"
    case "$what" in
        trash)
            echo ":: emptying the trash"
            find "$HOME/.local/share/Trash/files" "$HOME/.local/share/Trash/info" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>&1
            echo "done" ;;
        cache-dir)
            [[ "$arg" =~ ^[A-Za-z0-9._@+-]+$ && -d "$cache/$arg" ]] || die "invalid cache folder: $arg"
            echo ":: clearing ~/.cache/$arg"
            find "$cache/$arg" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>&1
            echo "done" ;;
        pacman)    echo ":: pacman -Sc"; exec pkexec pacman -Sc "${PACMAN_FLAGS[@]}" 2>&1 ;;
        coredumps) echo ":: removing crash dumps"; exec pkexec find /var/lib/systemd/coredump -mindepth 1 -delete 2>&1 ;;
        journal)   echo ":: journalctl --vacuum-size=50M"; exec pkexec journalctl --vacuum-size=50M 2>&1 ;;
        flatpak)   echo ":: flatpak uninstall --unused"; exec flatpak uninstall --unused -y --noninteractive 2>&1 ;;
        smart)
            echo ":: smartctl -H -A (disk health)"
            exec pkexec sh -c 'for d in $(lsblk -dno NAME,TYPE | awk '"'"'$2 == "disk" && $1 !~ /^zram/ { print $1 }'"'"'); do
                echo "── /dev/$d"; smartctl -H -A /dev/$d | grep -Ei "result|overall|percentage used|power_on|wear|temperature" ; done' 2>&1 ;;
        *) die "unknown clean target: $what" ;;
    esac
}

timeinfo() {
    local fmt; fmt=$(grep -A2 '"clock"' "$HOME/.config/waybar/config.jsonc" 2>/dev/null | grep -oP '"format":\s*"\K[^"]*' | head -1)
    timedatectl show 2>/dev/null | jq -R -s --arg fmt "$fmt" --arg zones "$(timedatectl list-timezones 2>/dev/null)" '
        split("\n") | map(select(contains("=")) | capture("^(?<k>[^=]+)=(?<v>.*)$") | { (.k): .v }) | add
        | { timezone: .Timezone, ntp: (.NTP == "yes"), synced: (.NTPSynchronized == "yes"), canNtp: (.CanNTP == "yes"),
            localRtc: (.LocalRTC == "yes"), clockFormat: $fmt,
            zones: ($zones | split("\n") | map(select(length > 0))) }'
}

localeinfo() {
    local st; st=$(localectl status 2>/dev/null)
    jq -n --arg st "$st" --arg have "$(localectl list-locales 2>/dev/null)" \
          --arg all "$(grep -E '^#?[a-z]{2,3}_[A-Z]{2}\.UTF-8 UTF-8' /etc/locale.gen 2>/dev/null | sed 's/^#//; s/ UTF-8$//')" '
        ($st | split("\n") | map(select(test("LANG=|LC_"))) | map(gsub("^\\s*(System Locale:)?\\s*"; "")) | join(" ")
         | [scan("(LANG|LC_[A-Z]+)=([^ ]+)")] | map({ (.[0]): .[1] }) | add // {}) as $cur
        | { current: $cur, lang: ($cur.LANG // "C"),
            formats: ($cur.LC_TIME // $cur.LANG // "C"),
            generated: ($have | split("\n") | map(select(length > 0))),
            available: ($all | split("\n") | map(select(length > 0))) }'
}

set_locale() {
    local lang=$1 formats=$2 l
    for l in "$lang" "$formats"; do [[ "$l" =~ ^[A-Za-z_]+(\.UTF-8)?$ ]] || die "invalid locale: $l"; done
    echo ":: LANG=$lang, formats $formats (applies after you log in again)"
    exec pkexec sh -c '
        for l in "$1" "$2"; do
            [ "$l" = C.UTF-8 ] && continue
            if ! locale -a | grep -qix "$(echo "$l" | sed "s/UTF-8/utf8/")"; then
                sed -i "s/^#\s*\($l UTF-8\)/\1/" /etc/locale.gen && echo "generating $l" && regen=1
            fi
        done
        [ -n "$regen" ] && locale-gen
        localectl set-locale LANG="$1" LC_TIME="$2" LC_NUMERIC="$2" LC_MONETARY="$2" LC_PAPER="$2" LC_MEASUREMENT="$2"
    ' sh "$lang" "$formats" 2>&1
}

set_clock() {
    local fmt=$1 f
    [[ "$fmt" =~ ^[^\"\\]+$ ]] || die "invalid clock format"
    local repo; repo=$(cat "$HOME/.config/niri-rice/dotfiles-path" 2>/dev/null || echo "$HOME/dotfiles")
    for f in "$HOME/.config/waybar/config.jsonc" "$repo/.config/waybar/config.jsonc"; do
        [[ -f "$f" ]] || continue
        python3 - "$f" "$fmt" <<'PY'
import re, sys
path, fmt = sys.argv[1], sys.argv[2]
s = open(path).read()
new = re.sub(r'("clock"\s*:\s*\{[^}]*?"format"\s*:\s*")[^"]*(")', lambda m: m.group(1) + fmt + m.group(2), s, count=1)
if new != s:
    open(path, "w").write(new)
PY
    done
    systemctl --user restart waybar.service 2>/dev/null
}

account() {
    local ent; ent=$(getent passwd "$USER")
    jq -n --arg ent "$ent" --arg groups "$(id -nG)" --arg last "$(last -n 6 -F "$USER" 2>/dev/null | grep -v '^$\|^wtmp' | head -6)" \
          --arg keyring "$(pgrep -x gnome-keyring-d >/dev/null && echo running || echo stopped)" \
          --arg seahorse "$(command -v seahorse >/dev/null && echo yes)" '
        ($ent | split(":")) as $p
        | { user: $p[0], uid: ($p[2] | tonumber), name: ($p[4] | split(",")[0]), home: $p[5], shell: $p[6],
            groups: ($groups | split(" ")), admin: ($groups | split(" ") | index("wheel") != null),
            logins: ($last | split("\n") | map(select(length > 0))),
            keyring: $keyring, seahorse: ($seahorse == "yes") }'
}

privacy() {
    local mic cam screen
    mic=$(pactl -f json list source-outputs 2>/dev/null | jq -c --argjson mon "$(pactl -f json list sources 2>/dev/null | jq '[.[] | select(.monitor_source != "" and .monitor_source != null) | .index]')" \
        '[.[] | select(.source as $s | $mon | index($s) | not) | .properties."application.name" // .properties."application.process.binary" // "?"] | unique')
    cam=$(for d in /dev/video*; do [[ -e "$d" ]] && fuser "$d" 2>/dev/null; done | tr ' ' '\n' | grep -E '^[0-9]+$' | sort -u |
        while read -r p; do cat "/proc/$p/comm" 2>/dev/null; done | sort -u | jq -R . | jq -s -c .)
    screen=$(pw-dump 2>/dev/null | jq -c '[.[] | select(.type == "PipeWire:Interface:Node")
        | select((.info.props."media.class" // "") == "Stream/Input/Video")
        | .info.props."application.name" // .info.props."node.name" // "?"] | unique')
    jq -n --argjson mic "${mic:-[]}" --argjson cam "${cam:-[]}" --argjson screen "${screen:-[]}" \
          --arg recent "$(grep -c '<bookmark' "$HOME/.local/share/recently-used.xbel" 2>/dev/null || echo 0)" \
          --arg thumbs "$(dsize "${XDG_CACHE_HOME:-$HOME/.cache}/thumbnails")" \
          --arg launcher "$(jq length "${XDG_CACHE_HOME:-$HOME/.cache}/niri-rice/launcher-recent.json" 2>/dev/null || echo 0)" '
        { microphone: $mic, camera: $cam, screen: $screen,
          recentFiles: ($recent | tonumber? // 0), thumbnails: ($thumbs | tonumber? // 0), launcherRecent: ($launcher | tonumber? // 0) }'
}

privacy_clear() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}"
    case "$1" in
        recent)   printf '<?xml version="1.0" encoding="UTF-8"?>\n<xbel version="1.0"\n      xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks"\n      xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info"\n>\n</xbel>\n' > "$HOME/.local/share/recently-used.xbel" ;;
        thumbs)   rm -rf "$cache/thumbnails" ;;
        launcher) echo '[]' > "$cache/niri-rice/launcher-recent.json" ;;
        *) die "unknown: $1" ;;
    esac
}

MANGO="$HOME/.config/MangoHud/MangoHud.conf"
GAMING_ENV="$HOME/.config/environment.d/rp-gaming.conf"

gaming() {
    local mh="{}"
    [[ -f "$MANGO" ]] && mh=$(grep -Ev '^\s*(#|$)' "$MANGO" | jq -R -s 'split("\n") | map(select(length > 0) | capture("^(?<k>[^=]+?)\\s*(=\\s*(?<v>.*))?$") | { (.k): (.v // true) }) | add // {}')
    jq -n --argjson mh "$mh" --arg gm "$(gamemoded -s 2>/dev/null)" \
          --arg env "$(cat "$GAMING_ENV" 2>/dev/null)" \
          --arg tools "$(for t in gamemoded mangohud gamescope steam lutris heroic vkbasalt; do command -v $t >/dev/null && echo $t; done)" '
        { gamemode: ($gm | test("is active")), mangohud: $mh, mangoConfig: ($mh != {}),
          mangoEverywhere: ($env | test("MANGOHUD=1")), tools: ($tools | split("\n") | map(select(length > 0))) }'
}

mango_set() {
    local k=$1 v=$2
    [[ "$k" =~ ^[a-z_]+$ ]] || die "invalid MangoHud key"
    [[ "$v" =~ ^[A-Za-z0-9_.,+-]*$ ]] || die "invalid MangoHud value"
    mkdir -p "$(dirname "$MANGO")"; touch "$MANGO"
    python3 - "$MANGO" "$k" "$v" <<'PY'
import re, sys
path, k, v = sys.argv[1:4]
lines = open(path).read().split("\n")
pat = re.compile(rf"^\s*#?\s*{re.escape(k)}\s*(=|$)")
new = None if v == "off" else (k if v == "on" else f"{k}={v}")
out, done = [], False
for l in lines:
    if pat.match(l) and not l.lstrip().startswith("#"):
        if new and not done:
            out.append(new); done = True
        continue
    out.append(l)
if new and not done:
    out.append(new)
open(path, "w").write("\n".join(out))
PY
}

mango_everywhere() {
    mkdir -p "$(dirname "$GAMING_ENV")"
    if [[ "$1" == on ]]; then
        printf '# Z okna Settings → Gaming: MangoHud ve všech Vulkan hrách (platí po novém přihlášení)\nMANGOHUD=1\n' > "$GAMING_ENV"
        systemctl --user set-environment MANGOHUD=1
    else
        rm -f "$GAMING_ENV"
        systemctl --user unset-environment MANGOHUD
    fi
}

printers() {
    local def; def=$(lpstat -d 2>/dev/null | sed -n 's/^system default destination: //p')
    jq -n --arg p "$(lpstat -p 2>/dev/null)" --arg jobs "$(lpstat -o 2>/dev/null)" --arg def "$def" \
          --arg cups "$(systemctl is-active cups 2>/dev/null)" \
          --arg scp "$(command -v system-config-printer >/dev/null && echo yes)" '
        { cups: ($cups == "active"), default: $def, configTool: ($scp == "yes"),
          printers: ($p | split("\n") | map(select(startswith("printer ")) | capture("^printer (?<name>\\S+) (is |now )?(?<state>[^.]+)")
                     | . + { default: (.name == $def), enabled: (.state | test("disabled") | not) })),
          jobs: ($jobs | split("\n") | map(select(length > 0) | capture("^(?<id>\\S+)\\s+(?<user>\\S+)\\s+(?<size>\\d+)\\s+(?<date>.*)$"))) }'
}

printer_action() {
    local act=$1 p=${2:-}
    [[ -z "$p" || "$p" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid printer name"
    case "$act" in
        default) lpoptions -d "$p" >/dev/null ;;
        test)    lp -d "$p" /usr/share/cups/data/testprint 2>&1 ;;
        cancel)  cancel -a "$p" 2>&1 ;;
        *) die "unknown printer action: $act" ;;
    esac
}

backup() {
    jq -n --arg configs "$(snapper --csvout list-configs 2>/dev/null | tail -n +2)" \
          --arg fs "$(findmnt -no FSTYPE /)" \
          --arg timeline "$(systemctl is-enabled snapper-timeline.timer 2>/dev/null)" \
          --arg cleanup "$(systemctl is-enabled snapper-cleanup.timer 2>/dev/null)" \
          --arg snapPac "$(pacman -Qq snap-pac 2>/dev/null)" '
        { fs: $fs, snapper: ($configs != ""),
          configs: ($configs | split("\n") | map(select(length > 0) | split(",") | { name: .[0], subvolume: .[1] })),
          timeline: ($timeline == "enabled"), cleanup: ($cleanup == "enabled"), snapPac: ($snapPac != "") }'
}

snapshot() {
    local act=$1 cfg=${2:-root} desc=${3:-}
    [[ "$cfg" =~ ^[a-z0-9_-]+$ ]] || die "invalid snapper config"
    case "$act" in
        list)   echo ":: snapper -c $cfg list"; exec pkexec snapper -c "$cfg" list 2>&1 ;;
        create)
            [[ "$desc" =~ ^[A-Za-z0-9\ ._,:-]{1,60}$ ]] || die "description: letters, digits, spaces, up to 60 chars"
            echo ":: snapper -c $cfg create -d \"$desc\""
            exec pkexec snapper -c "$cfg" create -d "$desc" --print-number 2>&1 ;;
        *) die "unknown snapshot action: $act" ;;
    esac
}

settings_export() {
    local out="${1:-$HOME/rprice-settings-$(date +%Y%m%d-%H%M).tar.gz}"
    tar -czf "$out" -C "$HOME/.config/niri-rice" $(cd "$HOME/.config/niri-rice" && ls settings.json displays.json modules.conf 2>/dev/null) && echo "$out"
}

settings_import() {
    local f=$1
    [[ -f "$f" ]] || die "no such file: $f"
    tar -tzf "$f" | grep -qvE '^(settings\.json|displays\.json|modules\.conf)$' && die "unexpected files in archive"
    tar -xzf "$f" -C "$HOME/.config/niri-rice" && "$HOME/.local/bin/rp-settings" apply && echo "imported $f"
}

case "${1:-}" in
    info)        c="${XDG_CACHE_HOME:-$HOME/.cache}/niri-rice"; out=$(info) || exit 1; printf '%s\n' "$out"
                 mkdir -p "$c" && printf '%s\n' "$out" > "$c/sysinfo.json.$$" && mv -f "$c/sysinfo.json.$$" "$c/sysinfo.json" ;;
    updates)     updates ;;
    packages)    packages ;;
    pkginfo)     [[ $# -eq 2 ]] || die "usage: rp-sys pkginfo <name>"; pkginfo "$2" ;;
    search)      [[ $# -eq 2 ]] || die "usage: rp-sys search <query>"; search "$2" ;;
    firewall)    firewall ;;
    fw-services) fw_services ;;

    upgrade)
        echo ":: pacman -Syu"
        exec pkexec pacman -Syu "${PACMAN_FLAGS[@]}" 2>&1 ;;
    upgrade-all)
        if has paru; then
            echo ":: paru -Syu (repositories and AUR, building as $USER, installing through pkexec)"
            paru -Syu --noconfirm --sudo pkexec --skipreview --batchinstall --failfast --noprogressbar --color never 2>&1 || exit $?
        else
            echo ":: pacman -Syu"
            pkexec pacman -Syu "${PACMAN_FLAGS[@]}" 2>&1 || exit $?
        fi
        if has flatpak; then
            echo ":: flatpak update"
            flatpak update -y --noninteractive 2>&1 || exit $?
        fi
        echo ":: all up to date" ;;
    upgrade-aur)
        has paru || die "paru is not installed"
        echo ":: paru -Sua (building as $USER, installing through pkexec)"
        exec paru -Sua --noconfirm --sudo pkexec --skipreview --batchinstall --failfast --noprogressbar --color never 2>&1 ;;
    upgrade-flatpak)
        echo ":: flatpak update"
        exec flatpak update -y --noninteractive 2>&1 ;;
    install)
        shift; [[ $# -gt 0 ]] || die "usage: rp-sys install <pkg…>"; valid_pkgs "$@"
        repo=(); aurp=()
        for p in "$@"; do
            if pacman -Si "$p" >/dev/null 2>&1; then repo+=("$p"); else aurp+=("$p"); fi
        done
        if (( ${#repo[@]} )); then
            echo ":: pacman -S ${repo[*]}"
            pkexec pacman -S --needed "${PACMAN_FLAGS[@]}" "${repo[@]}" 2>&1 || exit $?
        fi
        if (( ${#aurp[@]} )); then
            has paru || die "not in the repositories and paru is missing: ${aurp[*]}"
            echo ":: paru -S ${aurp[*]} (AUR)"
            paru -S --needed --noconfirm --sudo pkexec --skipreview --batchinstall --failfast --noprogressbar --color never "${aurp[@]}" 2>&1 || exit $?
        fi ;;
    remove)
        shift; [[ $# -gt 0 ]] || die "usage: rp-sys remove <pkg…>"; valid_pkgs "$@"
        pac=(); flat=()
        for p in "$@"; do
            if pacman -Qq "$p" >/dev/null 2>&1; then pac+=("$p"); else flat+=("$p"); fi
        done
        if (( ${#pac[@]} )); then
            echo ":: pacman -Rns ${pac[*]}"
            pkexec pacman -Rns "${PACMAN_FLAGS[@]}" "${pac[@]}" 2>&1 || exit $?
        fi
        if (( ${#flat[@]} )); then
            echo ":: flatpak uninstall ${flat[*]}"
            flatpak uninstall -y --noninteractive "${flat[@]}" 2>&1 || exit $?
        fi ;;
    remove-orphans)
        mapfile -t orphans < <(pacman -Qqdt)
        (( ${#orphans[@]} )) || { echo "No orphaned packages."; exit 0; }
        echo ":: pacman -Rns ${orphans[*]}"
        exec pkexec pacman -Rns "${PACMAN_FLAGS[@]}" "${orphans[@]}" 2>&1 ;;
    keep)
        shift; [[ $# -gt 0 ]] || die "usage: rp-sys keep <pkg…>"; valid_pkgs "$@"
        echo ":: pacman -D --asexplicit $*"
        exec pkexec pacman -D --asexplicit "$@" 2>&1 ;;
    clean-cache)
        echo ":: pacman -Sc (keeps installed versions, drops the rest)"
        exec pkexec pacman -Sc "${PACMAN_FLAGS[@]}" 2>&1 ;;
    fw) shift; fw "$@" 2>&1 ;;
    storage)       storage ;;
    storage-home)  storage_home ;;
    clean)         shift; clean "$@" ;;
    time)          timeinfo ;;
    set-timezone)  [[ "${2:-}" =~ ^[A-Za-z_+/-]+$ ]] || die "invalid timezone"; timedatectl set-timezone "$2" 2>&1 ;;
    set-ntp)       timedatectl set-ntp "${2:-true}" 2>&1 ;;
    set-clock)     set_clock "${2:-}" ;;
    locale)        localeinfo ;;
    set-locale)    set_locale "${2:-}" "${3:-${2:-}}" ;;
    account)       account ;;
    privacy)       privacy ;;
    privacy-clear) privacy_clear "${2:-}" ;;
    gaming)        gaming ;;
    mango-set)     mango_set "${2:-}" "${3:-}" ;;
    mango-everywhere) mango_everywhere "${2:-off}" ;;
    printers)      printers ;;
    printer)       printer_action "${2:-}" "${3:-}" ;;
    backup)        backup ;;
    snapshot)      snapshot "${2:-}" "${3:-root}" "${4:-}" ;;
    settings-export) settings_export "${2:-}" ;;
    settings-import) settings_import "${2:-}" ;;
    *)
        sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//' >&2
        exit 1 ;;
esac
