#!/usr/bin/env python3
"""rp-sound volume | device-added | device-removed | watch"""
import json
import os
import select
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".config/niri-rice/settings.json")
THEMES = [os.path.join(HOME, ".local/share/sounds/rpdots/stereo"), "/usr/share/sounds/freedesktop/stereo"]
SETTING = {"volume": "sounds.volume", "device-added": "sounds.devices", "device-removed": "sounds.devices"}
SOUND = {"volume": "audio-volume-change", "device-added": "device-added", "device-removed": "device-removed"}


def enabled(event):
    try:
        with open(STORE) as f:
            v = json.load(f).get(SETTING[event], True)
    except (OSError, ValueError):
        return True
    return str(v).lower() != "false"


def play(event):
    if not enabled(event):
        return
    for d in THEMES:
        for ext in (".oga", ".ogg", ".wav"):
            path = os.path.join(d, SOUND[event] + ext)
            if os.path.isfile(path):
                subprocess.Popen(["pw-play", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                return


def suspended():
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


def watch():
    mon = subprocess.Popen(["udevadm", "monitor", "--udev", "--subsystem-match=usb", "--property"],
                           stdout=subprocess.PIPE, text=True, bufsize=1)
    props, last, quiet_until = {}, {}, 0.0
    slept = suspended()
    while True:
        ready, _, _ = select.select([mon.stdout], [], [], 2)
        now = time.monotonic()
        if suspended() - slept > 1:
            quiet_until = now + 10
        slept = suspended()
        if not ready:
            continue
        line = mon.stdout.readline()
        if not line:
            sys.exit(1)
        line = line.strip()
        if "=" in line:
            k, v = line.split("=", 1)
            props[k] = v
            continue
        if line or not props:
            continue
        p, props = props, {}
        action = p.get("ACTION")
        if action not in ("add", "remove") or p.get("DEVTYPE") != "usb_device":
            continue
        if p.get("TYPE", "").startswith("9/") or now < quiet_until:
            continue
        event = "device-added" if action == "add" else "device-removed"
        if now - last.get(event, 0) < 1.5:
            continue
        last[event] = now
        play(event)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "watch":
        watch()
    elif arg in SOUND:
        play(arg)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
