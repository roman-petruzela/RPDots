#!/usr/bin/env bash
set -uo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rp-audio"
BLACKLIST_FILE="$CONF_DIR/blacklist.conf"
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/rp-audio"
VOL_STATE="$STATE_DIR/volume"
MUTE_STATE="$STATE_DIR/mute"
APPLY_LOCK="$STATE_DIR/applying"

MAX_VOL=65536
STEP=$(( MAX_VOL * 2 / 100 ))

DEFAULT_BLACKLIST=(obs easyeffects)

mkdir -p "$STATE_DIR"

sink_ids()   { pactl list short sinks 2>/dev/null | awk '{print $1}'; }
sink_names() { pactl list short sinks 2>/dev/null | awk '{print $2}'; }

raw_of()  { pactl get-sink-volume "$1" 2>/dev/null | awk 'NR==1{print $3; exit}'; }
mute_of() { pactl get-sink-mute   "$1" 2>/dev/null | awk 'NR==1{print $2; exit}'; }

pct_of_raw() { awk -v r="${1:-0}" -v m="$MAX_VOL" 'BEGIN{printf "%d", (r*100/m)+0.5}'; }

global_vol()  { cat "$VOL_STATE"  2>/dev/null || raw_of  @DEFAULT_SINK@; }
global_mute() { cat "$MUTE_STATE" 2>/dev/null || mute_of @DEFAULT_SINK@; }

read_blacklist() {
    if [[ -r "$BLACKLIST_FILE" ]]; then
        sed 's/#.*//' "$BLACKLIST_FILE"
    else
        printf '%s\n' "${DEFAULT_BLACKLIST[@]}"
    fi | tr -d ' \t' | tr '[:upper:]' '[:lower:]' | grep -v '^$'
}

osd() {
    [[ -n "${RP_AUDIO_NO_OSD:-}" ]] && return 0
    "$HOME/.local/bin/rp-shell" osd-volume trigger || true
}

set_all_raw() {
    local raw="$1" id
    (( raw < 0 )) && raw=0
    (( raw > MAX_VOL )) && raw=$MAX_VOL
    : > "$APPLY_LOCK"
    for id in $(sink_ids); do
        pactl set-sink-volume "$id" "$raw" 2>/dev/null || true
    done
    echo "$raw" > "$VOL_STATE"
    ( sleep 0.15; rm -f "$APPLY_LOCK" ) &
    disown
}

set_all_mute() {
    local state="$1" id flag
    [[ "$state" == "yes" ]] && flag=1 || flag=0
    : > "$APPLY_LOCK"
    for id in $(sink_ids); do
        pactl set-sink-mute "$id" "$flag" 2>/dev/null || true
    done
    echo "$state" > "$MUTE_STATE"
    ( sleep 0.15; rm -f "$APPLY_LOCK" ) &
    disown
}

unpin_streams() {
    local bl ids
    bl=$(read_blacklist | jq -R . | jq -s .) || return 0

    ids=$(pw-dump 2>/dev/null | jq -r --argjson bl "$bl" '
        [ .[]
          | select(.type == "PipeWire:Interface:Node")
          | select(.info.props."media.class" == "Stream/Output/Audio")
          | { id: .id,
              tag: ( ( (.info.props."application.process.binary" // "") + "|"
                     + (.info.props."application.name"           // "") + "|"
                     + (.info.props."node.name"                  // "") )
                     | ascii_downcase ) }
        ]
        | map(select( .tag as $t | ( $bl | map(select($t | contains(.))) | length ) == 0 ))
        | .[].id
    ' 2>/dev/null) || return 0

    local nid
    for nid in $ids; do
        pw-metadata -n default "$nid" target.object -1 Spa:Id >/dev/null 2>&1 || true
        pw-metadata -n default "$nid" target.node   -1 Spa:Id >/dev/null 2>&1 || true
    done
}

cmd_switch() {
    local target="${1:-}"
    [[ -n "$target" ]] || { echo "rp-audio: missing output" >&2; return 1; }
    pactl set-default-sink "$target" 2>/dev/null || return 1
    unpin_streams
    set_all_raw "$(global_vol)"
    set_all_mute "$(global_mute)"
}

cmd_cycle() {
    local current next idx=0 i
    current=$(pactl get-default-sink 2>/dev/null) || return 1
    mapfile -t sinks < <(sink_names)
    (( ${#sinks[@]} <= 1 )) && return 0
    for i in "${!sinks[@]}"; do
        [[ "${sinks[$i]}" == "$current" ]] && { idx=$i; break; }
    done
    next="${sinks[$(( (idx + 1) % ${#sinks[@]} ))]}"
    cmd_switch "$next"
    osd
}

cmd_volume() {
    local action="${1:-up}" cur new
    cur=$(global_vol)
    case "$action" in
        up)   new=$(( cur + STEP )) ;;
        down) new=$(( cur - STEP )) ;;
        set)  new=$(( MAX_VOL * ${2:-0} / 100 )) ;;
        *)    echo "rp-audio: unknown argument '$action'" >&2; return 1 ;;
    esac
    set_all_raw "$new"
    osd
}

cmd_mute() {
    local action="${1:-toggle}" new
    case "$action" in
        on)     new=yes ;;
        off)    new=no ;;
        toggle) [[ "$(global_mute)" == "yes" ]] && new=no || new=yes ;;
        *)      echo "rp-audio: unknown argument '$action'" >&2; return 1 ;;
    esac
    set_all_mute "$new"
    osd
}

cmd_sync() {
    set_all_raw  "$(raw_of  @DEFAULT_SINK@)"
    set_all_mute "$(mute_of @DEFAULT_SINK@)"
}

cmd_list() {
    local default; default=$(pactl get-default-sink 2>/dev/null)
    pw-dump 2>/dev/null | jq --arg def "$default" '
        [ .[]
          | select(.type == "PipeWire:Interface:Node")
          | select(.info.props."media.class" == "Audio/Sink")
          | { id:          .id,
              name:        .info.props."node.name",
              description: (.info.props."node.description" // .info.props."node.name"),
              active:      (.info.props."node.name" == $def) }
        ]'
}

cmd_status() {
    local sinks sources inputs outputs cards
    sinks=$(pactl -f json list sinks 2>/dev/null || echo '[]')
    sources=$(pactl -f json list sources 2>/dev/null || echo '[]')
    inputs=$(pactl -f json list sink-inputs 2>/dev/null || echo '[]')
    outputs=$(pactl -f json list source-outputs 2>/dev/null || echo '[]')
    cards=$(pactl -f json list cards 2>/dev/null || echo '[]')
    jq -n --argjson sinks "$sinks" --argjson sources "$sources" --argjson inputs "$inputs" \
          --argjson outputs "$outputs" --argjson cards "$cards" \
          --arg defSink "$(pactl get-default-sink 2>/dev/null)" \
          --arg defSource "$(pactl get-default-source 2>/dev/null)" \
          --arg vol "$(pct_of_raw "$(global_vol)")" --arg mute "$(global_mute)" \
          --argjson bl "$(read_blacklist | jq -R . | jq -s .)" '
        def pct: [.volume[]?.value_percent | rtrimstr("%") | tonumber] | (first // 0);
        def ports: [.ports[]? | { name, description, available: (.availability != "not available") }];
        def app: .properties as $p | {
            app: ($p."application.name" // $p."application.process.binary" // $p."node.name" // "Unknown"),
            icon: ($p."application.icon_name" // $p."application.process.binary" // ""),
            media: ($p."media.name" // "") };
        [$sources[] | select(.monitor_source != "" and .monitor_source != null) | .index] as $monitors
        | {
            volume: ($vol | tonumber), muted: ($mute == "yes"), blacklist: $bl,
            outputs: [$sinks[] | { id: .index, name, description, volume: pct, muted: .mute,
                                   default: (.name == $defSink), ports: ports, port: (.active_port // ""),
                                   virtual: ((.properties."device.api" // "") == "") }],
            inputs: [$sources[] | select(.monitor_source == "" or .monitor_source == null)
                     | { id: .index, name, description, volume: pct, muted: .mute,
                         default: (.name == $defSource), ports: ports, port: (.active_port // ""),
                         virtual: ((.properties."device.api" // "") == "") }],
            streams: [$inputs[] | select((.properties."application.id" // "") != "org.PulseAudio.pavucontrol")
                      | app + { id: .index, sink: .sink, volume: pct, muted: .mute,
                                corked: .corked }],
            recording: [$outputs[] | select((.properties."application.id" // "") != "org.PulseAudio.pavucontrol")
                        | select(.source as $s | $monitors | index($s) | not)
                        | app + { id: .index, source: .source }],
            cards: [$cards[] | { id: .index, name, description: (.properties."device.description" // .name),
                                 profile: .active_profile,
                                 profiles: [.profiles | to_entries[] | select(.value.available != false)
                                            | { name: .key, description: .value.description, priority: .value.priority }]
                                           | sort_by(-.priority) }]
          }'
}

check_pct() {
    [[ "${1:-}" =~ ^[0-9]+$ ]] && (( $1 <= 150 )) || { echo "rp-audio: volume must be 0-150" >&2; exit 1; }
}

mute_flag() {
    case "${1:-toggle}" in on) echo 1 ;; off) echo 0 ;; toggle) echo toggle ;;
        *) echo "rp-audio: expected toggle|on|off" >&2; exit 1 ;; esac
}

cmd_blacklist() {
    if [[ $# -eq 0 ]]; then read_blacklist; return; fi
    mkdir -p "$CONF_DIR"
    {
        echo "# Apps that keep their own output (substring of binary / app name / node name)."
        echo "# Edited from the Settings window; one entry per line."
        tr ',' '\n' <<<"$1" | tr -d ' \t' | tr '[:upper:]' '[:lower:]' | grep -v '^$'
    } > "$BLACKLIST_FILE"
}

SETTLE_SECS=4
SETTLE_DIR="$STATE_DIR/settling"

mark_settling() { mkdir -p "$SETTLE_DIR"; : > "$SETTLE_DIR/$1"; }

is_settling() {
    local f="$SETTLE_DIR/$1" mtime
    [[ -e "$f" ]] || return 1
    mtime=$(stat -c %Y "$f" 2>/dev/null || echo 0)
    if (( $(date +%s) - mtime > SETTLE_SECS )); then
        rm -f "$f"
        return 1
    fi
    return 0
}

apply_global_to() {
    local id="$1" flag
    [[ "$(global_mute)" == "yes" ]] && flag=1 || flag=0
    pactl set-sink-volume "$id" "$(global_vol)" 2>/dev/null || true
    pactl set-sink-mute   "$id" "$flag"         2>/dev/null || true
}

cmd_daemon() {
    rm -rf "$SETTLE_DIR"; mkdir -p "$SETTLE_DIR"

    echo "$(raw_of  @DEFAULT_SINK@)" > "$VOL_STATE"
    echo "$(mute_of @DEFAULT_SINK@)" > "$MUTE_STATE"
    set_all_raw  "$(global_vol)"
    set_all_mute "$(global_mute)"
    unpin_streams

    local _ ev kind id raw mute
    pactl subscribe 2>/dev/null | while read -r _ ev _ kind id; do
        ev=${ev//\'/}
        id=${id#\#}
        [[ -e "$APPLY_LOCK" ]] && continue

        case "$kind" in
            sink)
                case "$ev" in
                    new)
                        mark_settling "$id"
                        apply_global_to "$id"
                        ;;
                    change)
                        if is_settling "$id"; then
                            apply_global_to "$id"
                            continue
                        fi
                        raw=$(raw_of "$id")
                        mute=$(mute_of "$id")
                        [[ -n "$raw"  && "$raw"  != "$(global_vol)"  ]] && set_all_raw  "$raw"
                        [[ -n "$mute" && "$mute" != "$(global_mute)" ]] && set_all_mute "$mute"
                        ;;
                    remove)
                        rm -f "$SETTLE_DIR/$id"
                        ;;
                esac
                ;;
            sink-input)
                [[ "$ev" == "new" ]] && unpin_streams
                ;;
        esac
    done
}

case "${1:-}" in
    switch) shift; cmd_switch "$@" ;;
    cycle)  cmd_cycle ;;
    volume) shift; cmd_volume "$@" ;;
    mute)   shift; cmd_mute "$@" ;;
    unpin)  unpin_streams ;;
    sync)   cmd_sync ;;
    list)   cmd_list ;;
    daemon) cmd_daemon ;;
    status) cmd_status ;;
    input)  [[ -n "${2:-}" ]] || exit 1; pactl set-default-source "$2" ;;
    source-volume) check_pct "${3:-}"; pactl set-source-volume "$2" "$3%" ;;
    source-mute)   pactl set-source-mute "$2" "$(mute_flag "${3:-}")" ;;
    stream-volume) check_pct "${3:-}"; pactl set-sink-input-volume "$2" "$3%" ;;
    stream-mute)   pactl set-sink-input-mute "$2" "$(mute_flag "${3:-}")" ;;
    stream-move)   pactl move-sink-input "$2" "$3" ;;
    rec-move)      pactl move-source-output "$2" "$3" ;;
    profile)       pactl set-card-profile "$2" "$3" ;;
    port)
        pactl set-sink-port "$2" "$3" 2>/dev/null || pactl set-source-port "$2" "$3" ;;
    blacklist) shift; cmd_blacklist "$@" ;;
    *)      sed -n '2,20p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
