hotkey-overlay {
    skip-at-startup
}
prefer-no-csd

input {
    keyboard {
        xkb {
            layout "cz,us"
            options "grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

environment {
    RP_GREETER_USER "@USER@"
    XDG_CACHE_HOME "/var/lib/rp-greeter/cache"
    XDG_STATE_HOME "/var/lib/rp-greeter/state"
    QT_QPA_PLATFORM "wayland"
}

layout {
    background-color "#000000"
}

spawn-sh-at-startup "qs -p /usr/share/rp-greeter/greeter; niri msg action quit --skip-confirmation"

binds {
}
