#!/usr/bin/env bash
set -euo pipefail

USER_HOME="$(getent passwd "${SUDO_USER:?run through sudo}" | cut -d: -f6)"
[[ -d "$USER_HOME" ]] || { echo "rp-lightdm-sync-apply: no home for $SUDO_USER" >&2; exit 1; }
SRC_THEME="$USER_HOME/.local/share/themes/RPRice"
SRC_WALLPAPER="$USER_HOME/.local/share/wallpapers/current"
DST_THEME="/usr/share/themes/RPRice"
DST_WALLPAPER="/usr/share/backgrounds/rprice-current.jpg"
GREETER_CONF="/etc/lightdm/lightdm-gtk-greeter.conf"

[[ -d "$SRC_THEME" ]] || exit 0
[[ -f "$SRC_WALLPAPER" ]] || exit 0

mkdir -p "$DST_THEME" /usr/share/backgrounds
rsync -a --delete "$SRC_THEME"/ "$DST_THEME"/
cp -f "$SRC_WALLPAPER" "$DST_WALLPAPER"
chmod -R a+rX "$DST_THEME"
chmod a+r "$DST_WALLPAPER"

set_key() {
    local key="$1" value="$2"
    if grep -qE "^${key}=" "$GREETER_CONF"; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$GREETER_CONF"
    elif grep -qE "^#${key}=" "$GREETER_CONF"; then
        sed -i "s|^#${key}=.*|${key}=${value}|" "$GREETER_CONF"
    else
        sed -i "/^\[greeter\]/a ${key}=${value}" "$GREETER_CONF"
    fi
}

SRC_COLORS="$USER_HOME/.config/quickshell/Colors.js"
SRC_LOCK="$USER_HOME/.config/quickshell/lock/LockContent.qml"
SRC_GREETER="$USER_HOME/.local/share/rp-greeter/greeter/shell.qml"
DST_GREETER="/usr/share/rp-greeter/greeter"
if [[ -d "$DST_GREETER" ]]; then
    [[ -f "$SRC_COLORS" ]] && install -m644 "$SRC_COLORS" "$DST_GREETER/Colors.js"
    [[ -f "$SRC_LOCK" ]] && install -Dm644 "$SRC_LOCK" "$DST_GREETER/lock/LockContent.qml"
    [[ -f "$SRC_GREETER" ]] && install -m644 "$SRC_GREETER" "$DST_GREETER/shell.qml"
fi

[[ -f "$GREETER_CONF" ]] || exit 0

set_key "theme-name" "RPRice"
set_key "icon-theme-name" "Papirus-Dark"
set_key "cursor-theme-name" "Bibata-Modern-Ice"
set_key "font-name" "Adwaita Sans 11"
set_key "background" "$DST_WALLPAPER"
